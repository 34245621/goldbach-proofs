section GoldbachGRHWindowParseval

open scoped BigOperators ComplexConjugate
open Finset

namespace GoldbachGRHWindow

noncomputable section

private theorem norm_energy_of_columns {A B : Type*} [Fintype A] [Fintype B]
    [DecidableEq A] (K : A → B → ℂ) (D : A → ℝ)
    (hK : ∀ r s : A, (∑ b : B, conj (K r b) * K s b) =
      if r = s then (D r : ℂ) else 0) (f : A → ℂ) :
    (∑ b : B, ‖∑ r : A, f r * K r b‖ ^ 2) =
      ∑ r : A, D r * ‖f r‖ ^ 2 := by
  apply Complex.ofReal_injective
  simp only [Complex.ofReal_sum, Complex.ofReal_mul, Complex.ofReal_pow, ← Complex.conj_mul']
  calc
    _ = ∑ b : B, ∑ r : A, ∑ s : A, conj (f r) * f s * (conj (K r b) * K s b) := by
      refine Finset.sum_congr rfl fun b _ => ?_
      simp only [map_sum, map_mul, Finset.sum_mul, Finset.mul_sum]
      rw [Finset.sum_comm]
      refine Finset.sum_congr rfl fun r _ => Finset.sum_congr rfl fun s _ => ?_
      ring
    _ = ∑ r : A, ∑ s : A, conj (f r) * f s * (∑ b : B, conj (K r b) * K s b) := by
      rw [Finset.sum_comm]
      refine Finset.sum_congr rfl fun r _ => ?_
      rw [Finset.sum_comm]
      simp only [Finset.mul_sum]
    _ = _ := by
      refine Finset.sum_congr rfl fun r _ => ?_
      simp only [hK, mul_ite, mul_zero, Finset.sum_ite_eq, Finset.mem_univ, ite_true]
      ring

variable {q : ℕ} [NeZero q]

omit [NeZero q] in
private theorem char_conj_of_unit (χ : DirichletCharacter ℂ q) {r : ZMod q}
    (hr : IsUnit r) : conj (χ r) = χ r⁻¹ := by
  have hχr : χ r ≠ 0 := (hr.map χ).ne_zero
  have hi : χ r⁻¹ = (χ r)⁻¹ := by
    calc
      _ = χ r⁻¹ * (χ r * (χ r)⁻¹) := by rw [mul_inv_cancel₀ hχr, mul_one]
      _ = _ := by rw [← mul_assoc, ← map_mul, ZMod.inv_mul_of_unit r hr, map_one, one_mul]
  exact (MulChar.star_apply' χ r).trans ((MulChar.inv_apply_eq_inv' χ r).trans hi.symm)

theorem multiplicative_energy (f : ZMod q → ℂ) :
    (∑ χ : DirichletCharacter ℂ q, ‖∑ r : ZMod q, f r * χ r‖ ^ 2) =
      (q.totient : ℝ) * ∑ r ∈ (univ : Finset (ZMod q)).filter IsUnit, ‖f r‖ ^ 2 := by
  rw [Finset.sum_filter, Finset.mul_sum]
  have hParseval := norm_energy_of_columns (fun r (χ : DirichletCharacter ℂ q) => χ r)
    (fun r : ZMod q => if IsUnit r then (q.totient : ℝ) else 0)
    (f := f) (by
      intro r s
      by_cases hr : IsUnit r
      · simp only [char_conj_of_unit _ hr, ite_eq_left hr, Complex.ofReal_natCast]
        exact DirichletCharacter.sum_char_inv_mul_char_eq ℂ hr s
      · simp [hr, MulChar.map_nonunit _ hr])
  rw [hParseval]
  refine Finset.sum_congr rfl fun r _ => ?_
  by_cases hr : IsUnit r <;> simp [hr]

end
end GoldbachGRHWindow
end GoldbachGRHWindowParseval

open Finset MeasureTheory Filter Complex
open scoped Interval ComplexConjugate Topology
namespace GBMean
noncomputable section

def wave (v t : ℝ) : ℂ := Complex.exp (((v*t:ℝ):ℂ)*Complex.I)
def gaussian (t : ℝ) := Real.exp (-(t^2))
def cross (v t : ℝ) : ℂ := (gaussian t:ℂ)*wave v t
def gaussConst : ℂ := (Real.pi:ℂ)^(1/2:ℂ)

theorem cross_form (v t : ℝ) : cross v t =
    Complex.exp ((-1:ℂ)*(t:ℂ)^2 + ((v:ℂ)*Complex.I)*t + 0) := by
  unfold cross gaussian wave
  rw [Complex.ofReal_exp,← Complex.exp_add]
  congr 1; push_cast; ring

theorem cross_integrable (v : ℝ) : Integrable (cross v) volume := by
  simpa only [funext (cross_form v)] using integrable_cexp_quadratic' (b:=(-1:ℂ))
    (by norm_num) ((v:ℂ)*Complex.I) 0

theorem cross_integral (v : ℝ) : (∫ t, cross v t) = gaussConst * (Real.exp (-(v^2)/4):ℝ) := by
  simp_rw [cross_form]
  rw [integral_cexp_quadratic (b:=(-1:ℂ)) (by norm_num)]
  unfold gaussConst
  simp only [neg_neg,div_one,Complex.ofReal_exp]
  congr 2
  push_cast; rw [mul_pow,Complex.I_sq]; ring

theorem wave_cross (v w t : ℝ) : wave v t * conj (wave w t) = wave (v-w) t := by
  unfold wave
  rw [← Complex.exp_conj,← Complex.exp_add]
  congr 1
  simp only [map_mul,Complex.conj_ofReal,Complex.conj_I,Complex.ofReal_mul,Complex.ofReal_sub]
  ring

theorem gaussian_weights (m n : ℕ) (a : ℝ) (h : 2*(Nat.dist m n:ℝ) ≤ |a|) :
    Real.exp (-(a^2)/4) ≤ (1/2:ℝ)^(Nat.dist m n) := by
  let d := Nat.dist m n
  have hd : 0≤(d:ℝ) := by positivity
  have hd₂ : (d:ℝ)≤(d:ℝ)^2 := by
    by_cases hz : d=0
    · simp [hz]
    · have hone : (1:ℝ)≤d := by exact_mod_cast Nat.one_le_iff_ne_zero.mpr hz
      nlinarith only [mul_le_mul_of_nonneg_right hone hd]
  have hl := Real.log_le_sub_one_of_pos (by norm_num : 0 < (2:ℝ))
  have ha : (2*(d:ℝ))^2 ≤ a^2 := by
    simpa [sq_abs] using pow_le_pow_left₀ (by positivity : 0≤2*(d:ℝ)) h 2
  have he : -(a^2)/4 ≤ -((d:ℝ)*Real.log 2) := by
    nlinarith only [ha,hd₂,mul_le_mul_of_nonneg_left hl hd]
  apply (Real.exp_le_exp.mpr he).trans_eq
  rw [Real.exp_neg,Real.exp_nat_mul,Real.exp_log (by norm_num : 0<(2:ℝ))]
  simp [d,inv_pow,one_div]

theorem row_geometric (s : Finset ℕ) (m : ℕ) :
    (∑ n ∈ s, (1/2:ℝ)^Nat.dist m n) ≤ 4 := by
  let r := (1/2:ℝ)
  have subsum (I : Finset ℕ) : (∑ i ∈ I, r^i) ≤ 2 := by
    have hs : Summable (fun i : ℕ => r^i) := summable_geometric_of_lt_one (by norm_num [r]) (by norm_num [r])
    exact (hs.sum_le_tsum _ (fun _ _ => by dsimp [r]; positivity)).trans_eq (by simpa [r] using tsum_geometric_two)
  let R := s.filter (fun n => m≤n)
  let L := s.filter (fun n => ¬m≤n)
  have hr : (∑ n ∈ R, r^Nat.dist m n) ≤ 2 := by
    apply le_trans _ (subsum (R.image (fun n => n-m)))
    rw [sum_image]
    · exact le_of_eq (sum_congr rfl fun n hn => by rw [Nat.dist_eq_sub_of_le (mem_filter.mp hn).2])
    · intro i hi j hj he
      have hi' : m ≤ i := (mem_filter.mp hi).2
      have hj' : m ≤ j := (mem_filter.mp hj).2
      change i-m=j-m at he
      omega
  have hl : (∑ n ∈ L, r^Nat.dist m n) ≤ 2 := by
    apply le_trans _ (subsum (L.image (fun n => m-n)))
    rw [sum_image]
    · exact le_of_eq (sum_congr rfl fun n hn => by
        rw [Nat.dist_eq_sub_of_le_right (Nat.le_of_lt (lt_of_not_ge (mem_filter.mp hn).2))])
    · intro i hi j hj he
      have hi' : ¬m ≤ i := (mem_filter.mp hi).2
      have hj' : ¬m ≤ j := (mem_filter.mp hj).2
      change m-i=m-j at he
      omega
  rw [← sum_filter_add_sum_filter_not (s:=s) (p:=fun n => m≤n)]
  change (∑ n ∈ R, r^Nat.dist m n) + (∑ n ∈ L, r^Nat.dist m n) ≤ _
  linarith

end
end GBMean

open Finset MeasureTheory Filter Complex
open scoped Interval ComplexConjugate Topology
namespace GBMean
noncomputable section

def poly (s : Finset ℕ) (c : ℕ → ℂ) (v : ℕ → ℝ) (t : ℝ) :=
  ∑ n ∈ s, c n * wave (v n) t

def kweight (m n : ℕ) : ℝ := (1/2:ℝ)^Nat.dist m n

theorem schur (s : Finset ℕ) (c : ℕ → ℂ) :
    (∑ m ∈ s, ∑ n ∈ s, ‖c m‖*‖c n‖*kweight m n) ≤ 4*∑ m ∈ s, ‖c m‖^2 := by
  have side : (∑ m ∈ s, ∑ n ∈ s, ‖c m‖^2*kweight m n) ≤ 4*∑ m ∈ s, ‖c m‖^2 := by
    rw [Finset.mul_sum]
    refine sum_le_sum fun m _ => ?_
    rw [← Finset.mul_sum,mul_comm (4:ℝ)]
    exact mul_le_mul_of_nonneg_left (row_geometric s m) (sq_nonneg _)
  have side' : (∑ m ∈ s, ∑ n ∈ s, ‖c n‖^2*kweight m n) ≤ 4*∑ m ∈ s, ‖c m‖^2 := by
    conv_lhs => rw [sum_comm]
    simpa only [kweight,Nat.dist_comm] using side
  have mid : 2*(∑ m ∈ s, ∑ n ∈ s, ‖c m‖*‖c n‖*kweight m n) ≤
      (∑ m ∈ s, ∑ n ∈ s, (‖c m‖^2*kweight m n + ‖c n‖^2*kweight m n)) := by
    simp only [Finset.mul_sum]
    refine sum_le_sum fun m _ => sum_le_sum fun n _ => ?_
    have h := mul_nonneg (sq_nonneg (‖c m‖-‖c n‖)) (by unfold kweight; positivity : 0≤kweight m n)
    nlinarith only [h]
  simp only [sum_add_distrib] at mid
  linarith

theorem pointwise (s : Finset ℕ) (c : ℕ → ℂ) (v : ℕ → ℝ) (t : ℝ) :
    ((gaussian t * ‖poly s c v t‖^2:ℝ):ℂ) =
      ∑ m ∈ s, ∑ n ∈ s, (c m*conj (c n))*cross (v m-v n) t := by
  rw [Complex.ofReal_mul,Complex.ofReal_pow,← Complex.mul_conj']
  unfold poly
  simp only [map_sum,map_mul,Finset.sum_mul,Finset.mul_sum]
  conv_lhs => rw [sum_comm]
  refine sum_congr rfl fun m _ => sum_congr rfl fun n _ => ?_
  rw [cross,← wave_cross]
  ring

theorem moment_gaussian (s : Finset ℕ) (c : ℕ → ℂ) (v : ℕ → ℝ)
    (sep : ∀ m ∈ s, ∀ n ∈ s, 2*(Nat.dist m n:ℝ) ≤ |v m-v n|) :
    Integrable (fun t => gaussian t*‖poly s c v t‖^2) volume ∧
      (∫ t, gaussian t*‖poly s c v t‖^2) ≤ 4*‖gaussConst‖*∑ m ∈ s, ‖c m‖^2 := by
  let F := fun t => gaussian t*‖poly s c v t‖^2
  let A := fun m n => c m*conj (c n)
  have hi (m n : ℕ) : Integrable (fun t => A m n*cross (v m-v n) t) volume :=
    (cross_integrable _).const_mul _
  have he (t : ℝ) : (F t:ℂ) = ∑ m ∈ s, ∑ n ∈ s, A m n*cross (v m-v n) t := pointwise s c v t
  have hI : Integrable (fun t => (F t:ℂ)) volume := by
    simp_rw [he]
    exact integrable_finsetSum _ fun m _ => integrable_finsetSum _ fun n _ => hi m n
  have hIr : Integrable F volume := by exact hI.re
  refine ⟨hIr,?_⟩
  have raw : ((∫ t : ℝ, F t : ℝ):ℂ) = ∑ m ∈ s, ∑ n ∈ s,
      A m n*(gaussConst * (Real.exp (-((v m-v n)^2)/4):ℝ)) := by
    rw [← integral_complex_ofReal]
    simp_rw [he]
    rw [integral_finsetSum _ (fun m _ => integrable_finsetSum _ (fun n _ => hi m n))]
    refine sum_congr rfl fun m _ => ?_
    rw [integral_finsetSum _ (fun n _ => hi m n)]
    refine sum_congr rfl fun n _ => ?_
    rw [integral_const_mul,cross_integral]
  have hnon : 0 ≤ ∫ t, F t := integral_nonneg fun t => mul_nonneg (Real.exp_pos _).le (sq_nonneg _)
  calc
    _ = ‖((∫ t : ℝ, F t : ℝ):ℂ)‖ := by rw [Complex.norm_real,Real.norm_eq_abs,abs_of_nonneg hnon]
    _ ≤ ∑ m ∈ s, ∑ n ∈ s, ‖A m n*(gaussConst * (Real.exp (-((v m-v n)^2)/4):ℝ))‖ := by
      rw [raw]
      exact (norm_sum_le _ _).trans (sum_le_sum fun _ _ => norm_sum_le _ _)
    _ ≤ ‖gaussConst‖*(∑ m ∈ s, ∑ n ∈ s, ‖c m‖*‖c n‖*kweight m n) := by
      simp only [Finset.mul_sum,A,norm_mul,norm_conj,Complex.norm_real,Real.norm_eq_abs,
        abs_of_pos (Real.exp_pos _)]
      refine sum_le_sum fun m hm => sum_le_sum fun n hn => ?_
      have h := gaussian_weights m n (v m-v n) (sep m hm n hn)
      change _ ≤ kweight m n at h
      nlinarith only [mul_le_mul_of_nonneg_left h (by positivity : 0≤‖c m‖*‖c n‖*‖gaussConst‖)]
    _ ≤ _ := (mul_le_mul_of_nonneg_left (schur s c) (norm_nonneg _)).trans_eq (by ring)

end
end GBMean

open Finset MeasureTheory Filter Complex
open scoped Interval Topology
namespace GBMean
noncomputable section

def constant := 4*Real.exp 1*‖gaussConst‖

theorem unit_bound (s : Finset ℕ) (c : ℕ → ℂ) (v : ℕ → ℝ)
    (sep : ∀ m ∈ s, ∀ n ∈ s, 2*(Nat.dist m n:ℝ) ≤ |v m-v n|)
    {u : ℝ} (hu : 0≤u) (hu1 : u≤1) :
    (∫ t in (-u)..u, ‖poly s c v t‖^2) ≤ constant*∑ j ∈ s, ‖c j‖^2 := by
  obtain ⟨hI,hbd⟩ := moment_gaussian s c v sep
  have hcont : Continuous (fun t => ‖poly s c v t‖^2) := by unfold poly wave; fun_prop
  have hint := hI.const_mul (Real.exp 1)
  have hpos : ∀ t : ℝ, 0 ≤ gaussian t*‖poly s c v t‖^2 := fun _ =>
    mul_nonneg (Real.exp_pos _).le (sq_nonneg _)
  have hup : -u ≤ u := by linarith
  calc
    _ ≤ ∫ t in (-u)..u, Real.exp 1*(gaussian t*‖poly s c v t‖^2) := by
      apply intervalIntegral.integral_mono_on hup (hcont.intervalIntegrable ..) hint.intervalIntegrable
      intro t ht
      have ht1 : 0≤1+t := by linarith only [ht.1,hu1]
      have ht2 : 0≤1-t := by linarith only [ht.2,hu1]
      have ht' : t^2 ≤ 1 := by nlinarith only [mul_nonneg ht1 ht2]
      have hg : 1 ≤ Real.exp 1 * gaussian t := by
        unfold gaussian; rw [← Real.exp_add]; exact Real.one_le_exp (by linarith)
      nlinarith only [mul_le_mul_of_nonneg_right hg (sq_nonneg ‖poly s c v t‖)]
    _ ≤ ∫ t, Real.exp 1*(gaussian t*‖poly s c v t‖^2) := by
      rw [intervalIntegral.integral_of_le hup]
      exact setIntegral_le_integral hint (Eventually.of_forall fun t => mul_nonneg (Real.exp_pos _).le (hpos t))
    _ ≤ _ := by
      rw [integral_const_mul]
      exact (mul_le_mul_of_nonneg_left hbd (Real.exp_pos _).le).trans_eq (by unfold constant; ring)

theorem scaled_bound (s : Finset ℕ) (c : ℕ → ℂ) (v : ℕ → ℝ) (T W : ℝ) (hT : 0≤T)
    (hW : 0<W) (hTW : T≤W) (sep : ∀ m ∈ s, ∀ n ∈ s,
      2*(Nat.dist m n:ℝ) ≤ W*|v m-v n|) :
    (∫ t in (-T)..T, ‖poly s c v t‖^2) ≤ constant*W*∑ j ∈ s, ‖c j‖^2 := by
  let V := fun n => W*v n
  have hsep (m : ℕ) (hm : m∈s) (n : ℕ) (hn : n∈s) : 2*(Nat.dist m n:ℝ) ≤ |V m-V n| := by
    simpa only [V,←mul_sub,abs_mul,abs_of_pos hW] using sep m hm n hn
  have hunit := unit_bound s c V hsep (div_nonneg hT hW.le) ((div_le_one hW).2 hTW)
  have hpol (t : ℝ) : poly s c V t = poly s c v (t*W) := by
    apply sum_congr rfl
    intro i _
    unfold wave
    simp only [V]
    rw [show W*v i*t = v i*(t*W) by ring]
  simp_rw [hpol] at hunit
  let F := fun t => ‖poly s c v t‖^2
  change (∫ x in -(T/W)..(T/W), F (x*W)) ≤ _ at hunit
  rw [intervalIntegral.integral_comp_mul_right F hW.ne',neg_mul,div_mul_cancel₀ _ hW.ne',
      smul_eq_mul,← div_eq_inv_mul] at hunit
  exact ((div_le_iff₀ hW).mp hunit).trans_eq (by ring)

theorem progression_gap {a b N W q : ℝ} (ha : 0<a) (hab : a≤b) (hbN : b≤N)
    (hW : 0<W) (hq : 2*N ≤ W*q) {d : ℝ} (hd : 0≤d) (hdiff : b-a=d*q) :
    2*d ≤ W*|Real.log a - Real.log b| := by
  have hb := ha.trans_le hab
  have hlog := Real.log_le_sub_one_of_pos (div_pos ha hb)
  rw [Real.log_div ha.ne' hb.ne'] at hlog
  have hgap : (b-a) ≤ b*(Real.log b-Real.log a) := by
    have ht := mul_le_mul_of_nonneg_right hlog hb.le
    simp only [sub_mul,div_mul_cancel₀ _ hb.ne',one_mul] at ht
    linarith
  have hlogs := Real.log_le_log ha hab
  rw [abs_sub_comm,abs_of_nonneg (sub_nonneg.mpr hlogs)]
  apply le_of_mul_le_mul_left (a:=b) _ hb
  have hcap := mul_le_mul_of_nonneg_right (show 2*b ≤ W*q by linarith only [hbN,hq]) hd
  have hgap' := mul_le_mul_of_nonneg_left hgap hW.le
  rw [hdiff] at hgap'
  nlinarith only [hcap,hgap']

/-- The coefficients may be restricted to an arbitrary subset of a single residue progression. -/
theorem progression_mean (r q N : ℕ) (s : Finset ℕ) (c : ℕ → ℂ) (T W : ℝ)
    (hT : 0≤T) (hW : 0<W) (hTW : T≤W) (hscale : 2*(N:ℝ) ≤ W*(q:ℝ))
    (hs : ∀ n∈s, 0<r+n*q ∧ r+n*q≤N) :
    (∫ t in (-T)..T, ‖poly s c (fun n => Real.log (r+n*q:ℕ)) t‖^2) ≤
       constant*W*∑ n ∈ s, ‖c n‖^2 := by
  let v := fun n : ℕ => Real.log (r+n*q:ℕ)
  have hpair (m n : ℕ) (hm : m∈s) (hn : n∈s) (hmn : m≤n) :
      2*(Nat.dist m n:ℝ) ≤ W*|v m-v n| := by
    apply progression_gap (N:=(N:ℝ)) (q:=(q:ℝ))
    · exact_mod_cast (hs m hm).1
    · exact_mod_cast Nat.add_le_add_left (Nat.mul_le_mul_right q hmn) r
    · exact_mod_cast (hs n hn).2
    · exact hW
    · exact hscale
    · positivity
    · rw [Nat.dist_eq_sub_of_le hmn,Nat.cast_sub hmn]
      push_cast; ring
  apply scaled_bound _ _ _ _ _ hT hW hTW
  intro m hm n hn
  rcases le_total m n with h | h
  · exact hpair m n hm hn h
  · simpa only [Nat.dist_comm n m,abs_sub_comm (v n) (v m)] using hpair n m hn hm h

end
end GBMean

open Finset MeasureTheory Filter Complex
open scoped Interval Topology Classical
namespace GBMean
noncomputable section
variable {q : ℕ} [NeZero q]

def fiber (s : Finset ℕ) (r : ZMod q) := s.filter (fun n : ℕ => (n:ZMod q)=r)
def logPoly (s : Finset ℕ) (c : ℕ → ℂ) := poly s c (fun n : ℕ => Real.log (n:ℝ))
def twisted (s : Finset ℕ) (c : ℕ → ℂ) (χ : DirichletCharacter ℂ q) :=
  logPoly s (fun n => c n*χ (n:ZMod q))

theorem continuous_logPoly (s : Finset ℕ) (c : ℕ → ℂ) : Continuous (logPoly s c) := by
  unfold logPoly poly wave; fun_prop

theorem fiber_bound (r : ZMod q) (s : Finset ℕ) (c : ℕ → ℂ) (N : ℕ) (T W : ℝ)
    (hT : 0≤T) (hW : 0<W) (hTW : T≤W) (hscale : 2*(N:ℝ) ≤ W*(q:ℝ))
    (hs : ∀ n∈s, 0<n ∧ n≤N) :
    (∫ t in (-T)..T, ‖logPoly (fiber s r) c t‖^2) ≤
       constant*W*∑ n ∈ fiber s r, ‖c n‖^2 := by
  let J := fiber s r
  let I := J.image (fun n => n/q)
  let idx := fun i : ℕ => r.val+i*q
  have hrec (n : ℕ) (hn : n∈J) : idx (n/q) = n := by
    have hp := congrArg ZMod.val (mem_filter.mp hn).2
    rw [ZMod.val_natCast] at hp
    dsimp [idx]
    rw [←hp,Nat.mul_comm (n/q) q,Nat.mod_add_div]
  have hinj : Set.InjOn (fun n => n/q) J := by
    intro m hm n hn he
    exact (hrec m hm).symm.trans ((congrArg idx he).trans (hrec n hn))
  have hI (i : ℕ) (hi : i∈I) : 0 < idx i ∧ idx i ≤ N := by
    obtain ⟨n,hn,rfl⟩ := mem_image.mp hi
    rw [hrec n hn]
    exact hs n (mem_filter.mp hn).1
  have hr := progression_mean r.val q N I (fun i => c (idx i)) T W hT hW hTW hscale hI
  have eqP (t : ℝ) : poly I (fun i => c (idx i)) (fun i => Real.log (r.val+i*q:ℕ)) t =
      logPoly J c t := by
    unfold poly logPoly
    rw [show I=J.image (fun n => n/q) by rfl,sum_image hinj]
    apply sum_congr rfl
    intro n hn
    change c (idx (n/q))*wave (Real.log (idx (n/q):ℕ)) t = _
    rw [hrec n hn]
  simp_rw [eqP] at hr
  have eqC : (∑ i ∈ I, ‖c (idx i)‖^2) = ∑ n ∈ J, ‖c n‖^2 := by
    rw [show I=J.image (fun n => n/q) by rfl,sum_image hinj]
    exact sum_congr rfl fun n hn => by rw [hrec n hn]
  rwa [eqC] at hr

theorem character_orthogonality (s : Finset ℕ) (c : ℕ → ℂ) (t : ℝ) :
    (∑ χ : DirichletCharacter ℂ q, ‖twisted s c χ t‖^2) =
      (q.totient:ℝ)*∑ r ∈ (univ : Finset (ZMod q)).filter IsUnit, ‖logPoly (fiber s r) c t‖^2 := by
  rw [← GoldbachGRHWindow.multiplicative_energy]
  apply sum_congr rfl
  intro χ _
  congr 2
  symm
  calc
    _ = ∑ r : ZMod q, ∑ k ∈ fiber s r, c k * χ (k:ZMod q) * wave (Real.log (k:ℝ)) t := by
      apply sum_congr rfl
      intro r _
      unfold logPoly poly
      rw [Finset.sum_mul]
      apply sum_congr rfl
      intro k hk
      rw [(mem_filter.mp hk).2]
      ring
    _ = _ := Finset.sum_fiberwise s (fun k : ℕ => (k:ZMod q)) _

theorem hybrid_mean (s : Finset ℕ) (c : ℕ → ℂ) (N : ℕ) (T W : ℝ)
    (hT : 0≤T) (hW : 0<W) (hTW : T≤W) (hscale : 2*(N:ℝ) ≤ W*(q:ℝ))
    (hs : ∀ n∈s, 0<n ∧ n≤N) :
    (∑ χ : DirichletCharacter ℂ q, ∫ t in (-T)..T, ‖twisted s c χ t‖^2) ≤
       (q.totient:ℝ)*(constant*W)*∑ n ∈ s, ‖c n‖^2 := by
  let U := (univ : Finset (ZMod q)).filter IsUnit
  have ht (χ : DirichletCharacter ℂ q) : Continuous (fun t => ‖twisted s c χ t‖^2) :=
    (continuous_logPoly s _).norm.pow 2
  have hu (r : ZMod q) : Continuous (fun t => ‖logPoly (fiber s r) c t‖^2) :=
    (continuous_logPoly _ _).norm.pow 2
  rw [← intervalIntegral.integral_finsetSum (fun χ _ => (ht χ).intervalIntegrable ..)]
  simp_rw [character_orthogonality]
  rw [intervalIntegral.integral_const_mul,intervalIntegral.integral_finsetSum (fun r _ => (hu r).intervalIntegrable ..)]
  rw [mul_assoc (q.totient:ℝ)]
  apply mul_le_mul_of_nonneg_left _ (Nat.cast_nonneg _)
  calc
    _ ≤ ∑ r ∈ U, (constant*W)*∑ n ∈ fiber s r, ‖c n‖^2 :=
      sum_le_sum fun r _ => fiber_bound r s c N T W hT hW hTW hscale hs
    _ ≤ ∑ r : ZMod q, (constant*W)*∑ n ∈ fiber s r, ‖c n‖^2 := by
      apply sum_le_sum_of_subset_of_nonneg (filter_subset _ _)
      intro r _ _
      unfold constant
      positivity
    _ = _ := by
      rw [← Finset.mul_sum]
      congr 1
      exact Finset.sum_fiberwise s (fun k : ℕ => (k:ZMod q)) _

end
end GBMean

open Finset MeasureTheory Filter Complex
open scoped Interval Topology Classical
namespace GBMean
noncomputable section

def energy {q : ℕ} [NeZero q] (s : Finset ℕ) (c : ℕ → ℂ) (t : ℝ) : ℝ :=
  ∑ χ : DirichletCharacter ℂ q, ‖twisted s c χ t‖^2

theorem energy_cont (q : ℕ) [NeZero q] (s : Finset ℕ) (c : ℕ → ℂ) :
    Continuous (energy (q:=q) s c) := by
  unfold energy
  exact continuous_finsetSum _ fun χ _ => (continuous_logPoly s _).norm.pow 2

theorem energy_pos (q : ℕ) [NeZero q] (s : Finset ℕ) (c : ℕ → ℂ) (t : ℝ) :
    0 ≤ energy (q:=q) s c t := sum_nonneg fun _ _ => sq_nonneg _

def both (F : ℝ → ℝ) (t : ℝ) := F t + F (-t)

theorem integrated_both (F : ℝ → ℝ) (hF : Continuous F) (T : ℝ) :
    (∫ t in (0:ℝ)..T, both F t) = ∫ t in (-T)..T, F t := by
  unfold both
  have hn : Continuous (fun t : ℝ => F (-t)) := hF.comp continuous_neg
  rw [intervalIntegral.integral_add (hF.intervalIntegrable ..) (hn.intervalIntegrable ..),
      intervalIntegral.integral_comp_neg,neg_zero,add_comm,
      intervalIntegral.integral_add_adjacent_intervals (hF.intervalIntegrable ..) (hF.intervalIntegrable ..)]

theorem character_energy_bound (q : ℕ) [NeZero q] (s : Finset ℕ) (c : ℕ → ℂ)
    (N : ℕ) {T : ℝ} (hT : 0<T) (hs : ∀ n∈s, 0<n ∧ n≤N) :
    (∫ t in (0:ℝ)..T, both (energy (q:=q) s c) t) ≤
      ((q.totient:ℝ)*T + 2*(N:ℝ))*(constant*∑ n ∈ s, ‖c n‖^2) := by
  have hq : 0 < (q:ℝ) := by exact_mod_cast Nat.pos_of_ne_zero (NeZero.ne q)
  let W := T + 2*(N:ℝ)/(q:ℝ)
  have hTW : T≤W := by dsimp [W]; exact le_add_of_nonneg_right (by positivity)
  have hscale : 2*(N:ℝ)≤W*(q:ℝ) := by
    dsimp [W]; rw [add_mul,div_mul_cancel₀ _ hq.ne']; linarith only [mul_nonneg hT.le hq.le]
  have hm := hybrid_mean (q:=q) s c N T W hT.le (hT.trans_le hTW) hTW hscale hs
  rw [integrated_both _ (energy_cont ..)]
  unfold energy
  have ht (χ : DirichletCharacter ℂ q) : Continuous (fun t => ‖twisted s c χ t‖^2) := (continuous_logPoly s _).norm.pow 2
  rw [intervalIntegral.integral_finsetSum (fun χ _ => (ht χ).intervalIntegrable ..)]
  apply hm.trans
  have htot : (q.totient:ℝ)≤(q:ℝ) := by exact_mod_cast q.totient_le
  have he : (q.totient:ℝ)* (2*(N:ℝ)/(q:ℝ)) ≤ 2*(N:ℝ) := by
    have h := mul_le_mul_of_nonneg_right htot (show 0≤2*(N:ℝ)/(q:ℝ) by positivity)
    rw [mul_comm (q:ℝ),div_mul_cancel₀ _ hq.ne'] at h
    exact h
  have hc : 0≤constant*∑ n ∈ s, ‖c n‖^2 := by unfold constant; positivity
  calc
    _ = ((q.totient:ℝ)*T + (q.totient:ℝ)*(2*N/q))*(constant*∑ n ∈ s, ‖c n‖^2) := by dsimp [W]; ring
    _ ≤ _ := mul_le_mul_of_nonneg_right (add_le_add le_rfl he) hc

def potential (a b r : ℝ) := 4*a/r + 2*b/r^2

theorem tail_integrable {F : ℝ → ℝ} (hF : Continuous F) {r u : ℝ} (hr : 0<r) (hru : r≤u) :
    IntervalIntegrable (fun t => F t/t^2) volume r u := by
  apply ContinuousOn.intervalIntegrable
  apply hF.continuousOn.div (continuous_id.pow 2).continuousOn
  intro t ht
  rw [Set.uIcc_of_le hru] at ht
  exact pow_ne_zero _ (hr.trans_le ht.1).ne'

theorem bound_slab {F : ℝ → ℝ} (hF : Continuous F) (hp : ∀ t, 0≤F t)
    {a b : ℝ} (hb : 0≤b) (H : ∀ T>0, (∫ t in (0:ℝ)..T, F t) ≤ a*T+b)
    {r : ℝ} (hr : 0<r) :
    (∫ t in r..(2*r), F t/t^2) ≤ potential a b r - potential a b (2*r) := by
  have hr2 : r≤2*r := by linarith
  calc
    _ ≤ ∫ t in r..(2*r), F t/r^2 := by
      apply intervalIntegral.integral_mono_on hr2 (tail_integrable hF hr hr2) ((hF.div_const _).intervalIntegrable ..)
      intro t ht
      exact div_le_div_of_nonneg_left (hp t) (sq_pos_of_pos hr) (by nlinarith only [sq_nonneg (t-r),mul_nonneg hr.le (sub_nonneg.mpr ht.1)])
    _ = (∫ t in r..(2*r), F t)/r^2 := intervalIntegral.integral_div ..
    _ ≤ (a*(2*r)+b)/r^2 := by
      apply div_le_div_of_nonneg_right _ (sq_nonneg _)
      exact (intervalIntegral.integral_mono_interval hr.le hr2 le_rfl (Eventually.of_forall hp) (hF.intervalIntegrable ..)).trans (H _ (by positivity))
    _ ≤ _ := by unfold potential; field_simp; nlinarith

theorem dyadic_tail {F : ℝ → ℝ} (hF : Continuous F) (hp : ∀ t, 0≤F t)
    {a b : ℝ} (hb : 0≤b) (H : ∀ T>0, (∫ t in (0:ℝ)..T, F t) ≤ a*T+b)
    (k : ℕ) {r : ℝ} (hr : 0<r) :
    (∫ t in r..(2^k*r), F t/t^2) ≤ potential a b r - potential a b (2^k*r) := by
  induction k with
  | zero => simp
  | succ k ih =>
    let v := (2:ℝ)^k*r
    have hv : 0<v := by dsimp [v]; positivity
    have hrv : r≤v := by
      simpa only [one_mul] using mul_le_mul_of_nonneg_right (one_le_pow₀ (by norm_num : 1≤(2:ℝ)) (n:=k)) hr.le
    rw [show (2:ℝ)^(k+1)*r=2*v by dsimp [v]; ring,
      ←intervalIntegral.integral_add_adjacent_intervals (tail_integrable hF hr hrv) (tail_integrable hF hv (show v≤2*v by linarith))]
    have h := bound_slab hF hp hb H hv
    change _ ≤ potential a b r - potential a b v at ih
    linarith

theorem finite_tail {F : ℝ → ℝ} (hF : Continuous F) (hp : ∀ t, 0≤F t)
    {a b : ℝ} (ha : 0≤a) (hb : 0≤b) (H : ∀ T>0, (∫ t in (0:ℝ)..T, F t) ≤ a*T+b)
    {r u : ℝ} (hr : 0<r) (hu : r≤u) :
    (∫ t in r..u, F t/t^2) ≤ potential a b r := by
  obtain ⟨k,hk⟩ := pow_unbounded_of_one_lt (u/r) (by norm_num : 1<(2:ℝ))
  have hv := (div_lt_iff₀ hr).mp hk
  have h := dyadic_tail hF hp hb H k hr
  have hpv : 0≤potential a b (2^k*r) := by unfold potential; positivity
  apply (intervalIntegral.integral_mono_interval le_rfl hu hv.le
    (Eventually.of_forall fun t => div_nonneg (hp t) (sq_nonneg _)) (tail_integrable hF hr (hu.trans hv.le))).trans
  linarith
end
end GBMean

open Finset MeasureTheory Filter Complex
open scoped Interval Topology Classical
namespace GBMean
noncomputable section

theorem tail_infinite {F : ℝ → ℝ} (hF : Continuous F) (hp : ∀ t, 0≤F t)
    {a b : ℝ} (ha : 0≤a) (hb : 0≤b) (H : ∀ T>0, (∫ t in (0:ℝ)..T, F t) ≤ a*T+b)
    {r : ℝ} (hr : 0<r) :
    IntegrableOn (fun t => F t/t^2) (Set.Ioi r) ∧
    (∫ t in Set.Ioi r, F t/t^2) ≤ potential a b r := by
  have hf (t : ℝ) : 0≤F t/t^2 := div_nonneg (hp t) (sq_nonneg _)
  have hbd : ∀ᶠ u : ℝ in atTop, (∫ t in r..u, F t/t^2) ≤ potential a b r :=
    (eventually_ge_atTop r).mono fun u hu => finite_tail hF hp ha hb H hr hu
  have hint : IntegrableOn (fun t => F t/t^2) (Set.Ioi r) := by
    apply integrableOn_Ioi_of_intervalIntegral_norm_bounded (potential a b r) r (b:=id) (l:=atTop)
    · intro u
      by_cases hu : r≤u
      · exact (tail_integrable hF hr hu).1
      · simp [Set.Ioc_eq_empty_of_le (le_of_not_ge hu)]
    · exact tendsto_id
    · simpa only [id_eq,Real.norm_eq_abs,abs_of_nonneg (hf _)] using hbd
  exact ⟨hint,le_of_tendsto (intervalIntegral_tendsto_integral_Ioi r hint tendsto_id) hbd⟩

end
end GBMean

open Finset Complex
open scoped Classical
namespace GBMean
noncomputable section

def amp (n : ℕ) : ℝ := (Real.sqrt n)⁻¹
def osc (n : ℕ) (t : ℝ) := wave (Real.log n) t
def mellin (n : ℕ) (t : ℝ) : ℂ := (amp n:ℂ)*osc n t

theorem amp_nn (n : ℕ) : 0≤amp n := by unfold amp; positivity
theorem amp_anti {n k : ℕ} (hn : 0<n) (hk : n≤k) : amp k ≤ amp n := by
  apply inv_anti₀ (by exact Real.sqrt_pos_of_pos (by exact_mod_cast hn))
  exact Real.sqrt_le_sqrt (by exact_mod_cast hk)
theorem osc_norm (n : ℕ) (t : ℝ) : ‖osc n t‖ = 1 := Complex.norm_exp_ofReal_mul_I _
theorem mellin_norm (n : ℕ) (t : ℝ) : ‖mellin n t‖ = amp n := by
  unfold mellin; rw [norm_mul,osc_norm,Complex.norm_real,Real.norm_eq_abs,abs_of_nonneg (amp_nn _),mul_one]

theorem osc_diff (n : ℕ) (hn : 0<n) (t : ℝ) : ‖osc (n+1) t - osc n t‖ ≤ |t|/(n:ℝ) := by
  let d := Real.log (n+1:ℝ)-Real.log (n:ℝ)
  have hn' : 0<(n:ℝ) := by exact_mod_cast hn
  have hd : 0≤d := sub_nonneg.mpr (Real.log_le_log hn' (by linarith))
  have hd1 : d≤1/(n:ℝ) := by
    have h := Real.log_le_sub_one_of_pos (show 0<((n:ℝ)+1)/(n:ℝ) by positivity)
    rw [Real.log_div (by positivity) hn'.ne'] at h
    exact h.trans_eq (by field_simp; ring)
  have he : osc (n+1) t - osc n t =
      (Complex.exp (Complex.I*((d*t:ℝ):ℂ))-1)*osc n t := by
    unfold osc wave
    rw [sub_mul,one_mul,←Complex.exp_add]
    congr 2
    dsimp [d]
    push_cast
    ring
  rw [he,norm_mul,osc_norm,mul_one]
  have hv := Real.norm_exp_I_mul_ofReal_sub_one_le (x:=d*t)
  rw [Real.norm_eq_abs,abs_mul,abs_of_nonneg hd] at hv
  exact hv.trans ((mul_le_mul_of_nonneg_right hd1 (abs_nonneg _)).trans_eq (by ring))

theorem mellin_diff {N k : ℕ} (hN : 0<N) (hk : N≤k) (t : ℝ) :
    ‖mellin (k+1) t - mellin k t‖ ≤ amp k-amp (k+1)+amp N*(|t|/N) := by
  have hk0 := hN.trans_le hk
  have ham := amp_anti hk0 (Nat.le_succ k)
  have he : mellin (k+1) t - mellin k t =
      ((amp (k+1)-amp k:ℝ):ℂ)*osc (k+1) t + (amp k:ℂ)*(osc (k+1) t-osc k t) := by
    unfold mellin; push_cast; ring
  rw [he]
  apply (norm_add_le ..).trans
  rw [norm_mul,norm_mul,Complex.norm_real,Complex.norm_real,Real.norm_eq_abs,Real.norm_eq_abs,
      abs_of_nonpos (sub_nonpos.mpr ham),abs_of_nonneg (amp_nn _),osc_norm,mul_one,neg_sub]
  apply add_le_add le_rfl
  exact mul_le_mul (amp_anti hN hk)
    ((osc_diff k hk0 t).trans (div_le_div_of_nonneg_left (abs_nonneg _) (by exact_mod_cast hN) (by exact_mod_cast hk)))
    (norm_nonneg _) (amp_nn _)

theorem mellin_variation {N b : ℕ} (hN : 0<N) (hb : N<b) (hu : b≤2*N) (t : ℝ) :
    (∑ k ∈ Ioc N (b-1), ‖mellin (k+1) t-mellin k t‖) ≤ amp N*(1+|t|) := by
  let I := Ico (N+1) b
  have hI : Ioc N (b-1) = I := by ext k; simp [I]; omega
  rw [hI]
  have hcard : (I.card:ℝ) ≤ (N:ℝ) := by
    dsimp [I]; rw [Nat.card_Ico]; exact_mod_cast (by omega : b-(N+1)≤N)
  have htel : (∑ k ∈ I, (amp k - amp (k+1))) = amp (N+1)-amp b := by
    have h := Finset.sum_Ico_sub (fun k => -amp k) (show N+1≤b by omega)
    simpa only [neg_sub_neg] using h
  calc
    _ ≤ ∑ k ∈ I, (amp k-amp (k+1)+amp N*(|t|/N)) :=
      sum_le_sum fun k hk => mellin_diff hN (by have := (mem_Ico.mp hk).1; omega) t
    _ = amp (N+1)-amp b + (I.card:ℝ)*(amp N*(|t|/N)) := by rw [sum_add_distrib,htel,sum_const,nsmul_eq_mul]
    _ ≤ amp N + (N:ℝ)*(amp N*(|t|/N)) := by
      apply add_le_add ((sub_le_self _ (amp_nn b)).trans (amp_anti hN (Nat.le_succ _)))
      exact mul_le_mul_of_nonneg_right hcard (mul_nonneg (amp_nn _) (div_nonneg (abs_nonneg _) (Nat.cast_nonneg _)))
    _ = _ := by field_simp

theorem abel_mellin (g : ℕ → ℂ) {N b : ℕ} (hN : 0<N) (hb : N<b) (hu : b≤2*N) (t H : ℝ)
    (hp : ∀ k, N≤k → k≤b → ‖∑ i ∈ range (k+1), g i‖ ≤ H) :
    ‖∑ k ∈ Ioc N b, mellin k t*g k‖ ≤ amp N*(3+|t|)*H := by
  let G := fun k : ℕ => ∑ i ∈ range (k+1), g i
  have hH : 0≤H := (norm_nonneg _).trans (hp N le_rfl hb.le)
  have h := Finset.sum_Ioc_by_parts (fun k => mellin k t) g hb
  simp only [smul_eq_mul] at h
  rw [h]
  apply (norm_sub_le ..).trans
  apply (add_le_add (norm_sub_le ..) (norm_sum_le ..)).trans
  have htop (a k : ℕ) (ha : N≤a) (hk : N≤k) (hk' : k≤b) :
      ‖mellin a t*G k‖ ≤ amp N*H := by
    rw [norm_mul,mellin_norm]; exact mul_le_mul (amp_anti hN ha) (hp k hk hk') (norm_nonneg _) (amp_nn _)
  have hsum : (∑ k ∈ Ioc N (b-1), ‖(mellin (k+1) t - mellin k t)*G k‖) ≤ amp N*(1+|t|)*H := by
    calc
      _ ≤ ∑ k ∈ Ioc N (b-1), ‖mellin (k+1) t-mellin k t‖*H := by
        apply sum_le_sum; intro k hk; rw [norm_mul]
        obtain ⟨hl,hh⟩ := mem_Ioc.mp hk
        exact mul_le_mul_of_nonneg_left (hp k hl.le (by omega)) (norm_nonneg _)
      _ = _ := (Finset.sum_mul ..).symm
      _ ≤ _ := mul_le_mul_of_nonneg_right (mellin_variation hN hb hu t) hH
  exact (add_le_add (add_le_add (htop b b hb.le hb.le le_rfl) (htop (N+1) N (Nat.le_succ _) le_rfl hb.le)) hsum).trans_eq (by ring)
end
end GBMean

open Finset Filter Asymptotics
open scoped Topology Classical
namespace GBMean
open OAI.LargePrimeGaps
noncomputable section

def centered {q : ℕ} (χ : DirichletCharacter ℂ q) (n : ℕ) : ℂ :=
  if n=0 then 0 else χ (n:ZMod q)*(ArithmeticFunction.vonMangoldt n:ℂ)-(if χ=1 then 1 else 0)

theorem centered_prefix {q : ℕ} (χ : DirichletCharacter ℂ q) (k : ℕ) :
    (∑ n ∈ range (k+1), centered χ n) = primeCharacterError (k:ℝ) χ := by
  have hI : (range (k+1)).filter (fun n => n≠0) = Ioc 0 k := by
    ext n; simp; omega
  unfold primeCharacterError primeCharacterPrefix centered
  rw [Nat.floor_natCast]
  have hc (f : ℕ → ℂ) : (∑ n ∈ range (k+1), if n=0 then 0 else f n) = ∑ n ∈ Ioc 0 k, f n := by
    rw [←hI,sum_filter]; simp only [ite_not]
  rw [hc,sum_sub_distrib,sum_const,Nat.card_Ioc,Nat.sub_zero]
  split_ifs <;> simp

theorem log_power_small (a : ℕ) :
    ∀ᶠ N : ℕ in atTop, 4*(Real.log N)^a ≤ (N:ℝ) := by
  have h := (isLittleO_log_rpow_rpow_atTop (a:ℝ) (by norm_num : (0:ℝ)<1)).bound (by norm_num : (0:ℝ)<1/4)
  filter_upwards [tendsto_natCast_atTop_atTop.eventually h,eventually_ge_atTop (1:ℕ)] with N hN h1
  have hL := Real.log_nonneg (show (1:ℝ)≤N by exact_mod_cast h1)
  simp only [Real.rpow_natCast,Real.rpow_one,Real.norm_eq_abs,abs_of_nonneg (pow_nonneg hL _),
    abs_of_nonneg (Nat.cast_nonneg N (α:=ℝ))] at hN
  linarith

theorem endpoint_bound (a B : ℕ) :
    ∃ C : ℝ, 0<C ∧ ∀ᶠ N : ℕ in atTop, ∀ k : ℕ, N≤k → k≤2*N →
      ∀ q : ℕ, 0<q → (q:ℝ)≤(Real.log N)^B → ∀ χ : DirichletCharacter ℂ q,
        ‖primeCharacterError (k:ℝ) χ‖ ≤ C*N/(Real.log N)^a := by
  obtain ⟨M,hM,x₀,hx₀,hSW⟩ := siegelWalfisz ((a:ℝ)+1) ((B:ℝ)+1) (by positivity) (by positivity)
  refine ⟨2*M+1,by positivity,?_⟩
  have hlog : Tendsto (fun N : ℕ => Real.log N) atTop atTop :=
    Real.tendsto_log_atTop.comp tendsto_natCast_atTop_atTop
  filter_upwards [hlog.eventually (eventually_ge_atTop 1),tendsto_natCast_atTop_atTop.eventually (eventually_ge_atTop x₀),
    log_power_small (a+2),log_power_small B,eventually_ge_atTop (1:ℕ)] with N hLN hX hsmall hmod hN
  intro k hk hku q hq hqL χ
  let : NeZero q := ⟨hq.ne'⟩
  let L := Real.log N
  have hL : 1≤L := hLN
  have hLp : 0<L := zero_lt_one.trans_le hL
  have hNr : (0:ℝ)<N := by exact_mod_cast (show 0<N by omega)
  have hkr : (N:ℝ)≤k := by exact_mod_cast hk
  have hkur : (k:ℝ)≤2*N := by exact_mod_cast hku
  have hqNr : (q:ℝ)≤N := hqL.trans (by linarith only [hmod,pow_nonneg hLp.le B])
  have hqpos : (0:ℝ)<q := by exact_mod_cast hq
  have hlogq := Real.log_le_log hqpos hqNr
  have hkl : L≤Real.log k := Real.log_le_log hNr hkr
  have hlogk : Real.log k ≤ 2*L := by
    have h := Real.log_le_log (hNr.trans_le hkr) hkur
    rw [Real.log_mul (by norm_num) hNr.ne'] at h
    linarith only [h,Real.log_le_sub_one_of_pos (by norm_num : 0<(2:ℝ)),hL]
  have hnatlog : (Nat.log 2 k : ℝ) ≤ 2*Real.log k := by
    have h := Real.natLog_le_logb k 2
    simp only [Nat.cast_ofNat, Real.logb] at h
    refine h.trans ((div_le_iff₀ (by linarith [Real.log_two_gt_d9] : 0<Real.log 2)).mpr ?_)
    nlinarith only [mul_nonneg (hLp.le.trans hkl) (show 0≤2*Real.log 2-1 by linarith [Real.log_two_gt_d9])]
  have hcond : (χ.conductor:ℝ) ≤ q := by exact_mod_cast Nat.le_of_dvd hq χ.conductor_dvd_level
  have hlevel : (χ.conductor:ℝ) ≤ (Real.log k)^((B:ℝ)+1) := by
    apply hcond.trans (hqL.trans _)
    rw [Real.rpow_add_one (hLp.trans_le hkl).ne',Real.rpow_natCast]
    exact (pow_le_pow_left₀ hLp.le hkl B).trans (le_mul_of_one_le_right (by positivity) (hL.trans hkl))
  have hprimitive := hSW k (by exact hX.trans hkr) χ.conductor (Nat.pos_of_ne_zero χ.conductor_ne_zero) hlevel
    χ.primitiveCharacter χ.primitiveCharacter_isPrimitive
  have hi : ‖primeCharacterError (k:ℝ) χ‖ ≤ M*(k:ℝ)*(Real.log k)^(-((a:ℝ)+1)) + (Nat.log 2 k:ℝ)*Real.log q := by
    simpa only [Nat.floor_natCast] using (primeCharacterError_le_primitive k hq χ).trans (add_le_add hprimitive le_rfl)
  have hpowa : 0<L^a := pow_pos hLp _
  have hkpow : L^a ≤ (Real.log k)^((a:ℝ)+1) := by
    rw [Real.rpow_add_one (hLp.trans_le hkl).ne',Real.rpow_natCast]
    exact (pow_le_pow_left₀ hLp.le hkl a).trans (le_mul_of_one_le_right (by positivity) (hL.trans hkl))
  have hmain : M*(k:ℝ)*(Real.log k)^(-((a:ℝ)+1)) ≤ 2*M*(N:ℝ)/L^a := by
    rw [Real.rpow_neg (hLp.le.trans hkl),←div_eq_mul_inv]
    apply div_le_div₀ (by positivity) (by nlinarith only [mul_le_mul_of_nonneg_left hkur hM.le]) hpowa hkpow
  have hextra : (Nat.log 2 k:ℝ)*Real.log q ≤ (N:ℝ)/L^a := by
    have hh : (Nat.log 2 k:ℝ)≤4*L := by linarith only [hnatlog,hlogk]
    have hc := mul_le_mul hh hlogq (Real.log_nonneg (show (1:ℝ)≤q by exact_mod_cast hq)) (show 0≤4*L by positivity)
    refine hc.trans ((le_div_iff₀ hpowa).mpr ?_)
    change 4*L^(a+2) ≤ (N:ℝ) at hsmall
    exact (show 4*L*L*L^a = 4*L^(a+2) by ring).le.trans hsmall
  exact hi.trans ((add_le_add hmain hextra).trans_eq (by dsimp [L]; ring))
end
end GBMean

open Finset Filter Complex MeasureTheory
open scoped Topology Interval Classical
namespace GBMean
noncomputable section

def rawPoly {q : ℕ} (χ : DirichletCharacter ℂ q) (N b : ℕ) (t : ℝ) :=
  ∑ n ∈ Ioc N b, osc n t*centered χ n

theorem osc_abel (g : ℕ → ℂ) {N b : ℕ} (hN : 0<N) (hb : N<b) (hu : b≤2*N) (t H : ℝ)
    (hp : ∀ k, N≤k → k≤b → ‖∑ i ∈ range (k+1), g i‖ ≤ H) :
    ‖∑ k ∈ Ioc N b, osc k t*g k‖ ≤ (2+|t|)*H := by
  let G := fun k : ℕ => ∑ i ∈ range (k+1), g i
  have hH : 0≤H := (norm_nonneg _).trans (hp N le_rfl hb.le)
  have hN' : (0:ℝ)<N := by exact_mod_cast hN
  have h := Finset.sum_Ioc_by_parts (fun k => osc k t) g hb
  simp only [smul_eq_mul] at h
  rw [h]
  apply (norm_sub_le ..).trans
  apply (add_le_add (norm_sub_le ..) (norm_sum_le ..)).trans
  have htop (a k : ℕ) (hk : N≤k) (hk' : k≤b) : ‖osc a t*G k‖ ≤ H := by
    rw [norm_mul,osc_norm,one_mul]; exact hp k hk hk'
  have hsum : (∑ k ∈ Ioc N (b-1), ‖(osc (k+1) t - osc k t)*G k‖) ≤ |t| * H := by
    calc
      _ ≤ ∑ _k ∈ Ioc N (b-1), (|t|/(N:ℝ))*H := by
        apply sum_le_sum; intro k hk; rw [norm_mul]
        obtain ⟨hl,hh⟩ := mem_Ioc.mp hk
        exact mul_le_mul ((osc_diff k (hN.trans hl) t).trans (div_le_div_of_nonneg_left (abs_nonneg _) hN' (by exact_mod_cast hl.le)))
          (hp k hl.le (by omega)) (norm_nonneg _) (by positivity)
      _ ≤ (N:ℝ)*(|t|/N*H) := by
        rw [sum_const,nsmul_eq_mul,Nat.card_Ioc]
        exact mul_le_mul_of_nonneg_right (by exact_mod_cast (by omega : b-1-N≤N)) (by positivity)
      _ = _ := by field_simp
  exact (add_le_add (add_le_add (htop b b hb.le le_rfl) (htop (N+1) N le_rfl hb.le)) hsum).trans_eq (by ring)

theorem raw_low (a B c : ℕ) :
    ∃ C : ℝ, 0<C ∧ ∀ᶠ N : ℕ in atTop, ∀ q : ℕ, 0<q → (q:ℝ)≤(Real.log N)^B →
      ∀ χ : DirichletCharacter ℂ q, ∀ b : ℕ, N≤b → b≤2*N → ∀ t : ℝ, |t|≤(Real.log N)^c →
        ‖rawPoly χ N b t‖ ≤ C*N/(Real.log N)^a := by
  obtain ⟨M,hM,hSW⟩ := endpoint_bound (a+c) B
  have hlog : Tendsto (fun N : ℕ => Real.log N) atTop atTop := Real.tendsto_log_atTop.comp tendsto_natCast_atTop_atTop
  refine ⟨3*M,by positivity,?_⟩
  filter_upwards [hSW,hlog.eventually (eventually_ge_atTop 1),eventually_ge_atTop (1:ℕ)] with N hN hL hN1
  intro q hq hqL χ b hb hbu t ht
  have hLp := zero_lt_one.trans_le hL
  rcases hb.eq_or_lt with rfl | hb
  · simp only [rawPoly,Ioc_self,sum_empty,norm_zero]; positivity
  have hH (k : ℕ) (hl : N≤k) (hu : k≤b) :
      ‖∑ i ∈ range (k+1), centered χ i‖ ≤ M*N/(Real.log N)^(a+c) := by
    rw [centered_prefix]; exact hN k hl (hu.trans hbu) q hq hqL χ
  apply (osc_abel _ hN1 hb hbu t _ hH).trans
  have h1 := one_le_pow₀ hL (n:=c)
  calc
    _ ≤ 3*(Real.log N)^c*(M*N/(Real.log N)^(a+c)) := by
      apply mul_le_mul_of_nonneg_right (by linarith only [h1,ht]); positivity
    _ = _ := by rw [pow_add]; field_simp
end
end GBMean

open Finset MeasureTheory Filter Complex
open scoped Interval Topology Classical
namespace GBMean
noncomputable section
theorem low_raw_energy (a B c : ℕ) :
    ∃ C : ℝ, 0<C ∧ ∀ᶠ N : ℕ in atTop, ∀ q : ℕ, (hq : 0<q) → (q:ℝ)≤(Real.log N)^B →
      ∀ b : ℕ, N≤b → b≤2*N →
        letI : NeZero q := ⟨hq.ne'⟩
        (∑ χ : DirichletCharacter ℂ q, ∫ t in (-((Real.log N)^c))..((Real.log N)^c), ‖rawPoly χ N b t‖^2) ≤
          C*(N:ℝ)^2/(Real.log N)^a := by
  obtain ⟨M,hM,hSW⟩ := raw_low (a+B+c) B c
  have hlog : Tendsto (fun N : ℕ => Real.log N) atTop atTop := Real.tendsto_log_atTop.comp tendsto_natCast_atTop_atTop
  refine ⟨2*M^2,by positivity,?_⟩
  filter_upwards [hSW,hlog.eventually (eventually_ge_atTop 1),eventually_ge_atTop (1:ℕ)] with N hN hL hN1
  intro q hq hqL b hNb hb
  let : NeZero q := ⟨hq.ne'⟩
  let L := Real.log N
  let P := M*N/L^(a+B+c)
  have hL' : 1≤L := hL
  have hLp := zero_lt_one.trans_le hL'
  have hT : 0≤L^c := pow_nonneg hLp.le _
  have hp (χ : DirichletCharacter ℂ q) :
      (∫ t in (-(L^c))..(L^c), ‖rawPoly χ N b t‖^2) ≤ 2*L^c*P^2 := by
    have hct : Continuous (fun t => ‖rawPoly χ N b t‖^2) := by unfold rawPoly osc wave; fun_prop
    calc
      _ ≤ ∫ _t in (-(L^c))..(L^c), P^2 := by
        apply intervalIntegral.integral_mono_on (by linarith only [hT]) (hct.intervalIntegrable ..) (intervalIntegrable_const ..)
        intro t ht
        exact pow_le_pow_left₀ (norm_nonneg _) (hN q hq hqL χ b hNb hb t (abs_le.mpr ht)) 2
      _ = _ := by rw [intervalIntegral.integral_const,smul_eq_mul]; ring
  have hcard : Fintype.card (DirichletCharacter ℂ q) = q.totient := by
    simpa only [Nat.card_eq_fintype_card] using DirichletCharacter.card_eq_totient_of_hasEnoughRootsOfUnity ℂ q
  have hcardL : (q.totient:ℝ)≤L^B := (show (q.totient:ℝ)≤q by exact_mod_cast q.totient_le).trans hqL
  calc
    _ ≤ ∑ _χ : DirichletCharacter ℂ q, 2*L^c*P^2 := sum_le_sum fun χ _ => hp χ
    _ = (q.totient:ℝ)*(2*L^c*P^2) := by rw [sum_const,card_univ,hcard,nsmul_eq_mul]
    _ ≤ L^B*(2*L^c*P^2) := mul_le_mul_of_nonneg_right hcardL (by positivity)
    _ = (2*M^2*(N:ℝ)^2/L^a)/L^(a+B+c) := by
      dsimp [P]; rw [div_pow,mul_pow]
      simp only [pow_add]; field_simp
    _ ≤ _ := div_le_self (by positivity) (one_le_pow₀ hL')
end
end GBMean

open MeasureTheory Filter Complex ContinuousLinearMap
open scoped FourierTransform ComplexConjugate Convolution Topology
namespace GBMellinWindow
noncomputable section

def revConj (f : ℝ → ℂ) (x : ℝ) := conj (f (-x))
def corr (f : ℝ → ℂ) := f ⋆[ContinuousLinearMap.mul ℂ ℂ] revConj f

theorem rev_integrable {f : ℝ → ℂ} (hf : Integrable f) : Integrable (revConj f) := by
  apply hf.comp_neg.norm.mono' (Complex.continuous_conj.comp_aestronglyMeasurable hf.comp_neg.aestronglyMeasurable)
  exact Eventually.of_forall fun x => (Complex.norm_conj (f (-x))).le

theorem fourier_rev (f : ℝ → ℂ) (v : ℝ) : 𝓕 (revConj f) v = conj (𝓕 f v) := by
  rw [Real.fourier_real_eq_integral_exp_smul,Real.fourier_real_eq_integral_exp_smul,←integral_conj]
  let g := fun u : ℝ => conj (Complex.exp (((-2*Real.pi*u*v:ℝ):ℂ)*I) * f u)
  calc
    _ = ∫ u, g (-u) := by
      apply integral_congr_ae
      filter_upwards with u
      dsimp [g,revConj]
      rw [map_mul,←Complex.exp_conj]
      simp only [map_mul,Complex.conj_ofReal,Complex.conj_I]
      congr 2
      push_cast; ring
    _ = _ := integral_neg_eq_self g volume

theorem corr_repr (f : ℝ → ℂ) (x : ℝ) :
    corr f x = ∫ u, f u*conj (f (u-x)) := by
  unfold corr MeasureTheory.convolution revConj
  simp only [ContinuousLinearMap.mul_apply',neg_sub]

theorem fourier_corr {f : ℝ → ℂ} (hf : Integrable f) (v : ℝ) :
    𝓕 (corr f) v = ((‖𝓕 f v‖^2:ℝ):ℂ) := by
  have hr : Integrable (revConj f) := rev_integrable hf
  rw [corr,Real.fourier_mul_convolution_eq hf hr,fourier_rev,Complex.mul_conj']
  norm_cast

theorem corr_cont_zero {f : ℝ → ℂ} (hm : Measurable f) (hi : Integrable f)
    {M : ℝ} (hb : ∀ x, ‖f x‖≤M) (hc : ∀ᵐ x, ContinuousAt f x) : ContinuousAt (corr f) 0 := by
  let G := fun (x u : ℝ) => f u*conj (f (u-x))
  have hm' (x : ℝ) : Measurable (G x) := by
    dsimp [G]; exact hm.mul (Complex.continuous_conj.measurable.comp (hm.comp (measurable_id.sub_const x)))
  have hd (x u : ℝ) : ‖G x u‖ ≤ ‖f u‖*M := by
    dsimp [G]; rw [norm_mul,Complex.norm_conj]; exact mul_le_mul_of_nonneg_left (hb _) (norm_nonneg _)
  have hl : ∀ᵐ u : ℝ, Tendsto (fun x => G x u) (𝓝 0) (𝓝 (G 0 u)) := by
    filter_upwards [hc] with u hu
    have ht : Tendsto (fun x : ℝ => u-x) (𝓝 0) (𝓝 u) := by simpa using (tendsto_const_nhds (x:=u)).sub (tendsto_id (x:=𝓝 (0:ℝ)))
    dsimp [G]; rw [sub_zero]
    exact tendsto_const_nhds.mul (Complex.continuous_conj.continuousAt.tendsto.comp (hu.tendsto.comp ht))
  have h := tendsto_integral_filter_of_dominated_convergence (fun u => ‖f u‖*M)
    (Eventually.of_forall fun x => (hm' x).aestronglyMeasurable) (Eventually.of_forall fun x => Eventually.of_forall (hd x))
    (hi.norm.mul_const M) hl
  change Tendsto (corr f) (𝓝 0) (𝓝 (corr f 0))
  rw [show corr f = fun x => ∫ u, G x u from funext (corr_repr f)]
  exact h

theorem plancherel {f : ℝ → ℂ} (hm : Measurable f) (hi : Integrable f)
    {M : ℝ} (hb : ∀ x, ‖f x‖≤M) (hc : ∀ᵐ x, ContinuousAt f x)
    (ht : Integrable fun t => ‖𝓕 f t‖^2) :
    (∫ u, ‖f u‖^2) = ∫ t, ‖𝓕 f t‖^2 := by
  have hrev : Integrable (revConj f) := rev_integrable hi
  have hcorr : Integrable (corr f) := hi.integrable_convolution (ContinuousLinearMap.mul ℂ ℂ) hrev
  have hft : Integrable (𝓕 (corr f)) := by
    rw [show 𝓕 (corr f) = fun t => ((‖𝓕 f t‖^2:ℝ):ℂ) from funext (fourier_corr hi)]
    exact ht.ofReal
  have heq := hcorr.fourierInv_fourier_eq hft (corr_cont_zero hm hi hb hc)
  rw [Real.fourierInv_eq_fourier_neg,neg_zero,Real.fourier_real_eq_integral_exp_smul,corr_repr] at heq
  simp only [mul_zero,Complex.ofReal_zero,zero_mul,Complex.exp_zero,one_smul,sub_zero,Complex.mul_conj'] at heq
  simp_rw [fourier_corr hi] at heq
  apply Complex.ofReal_injective
  simpa only [←Complex.ofReal_pow,integral_complex_ofReal] using heq.symm
end
end GBMellinWindow

open MeasureTheory Filter Complex
open scoped FourierTransform ComplexConjugate Interval Topology
namespace GBMellinWindow
noncomputable section

def box (a δ : ℝ) := (Set.Ico (a-δ) a).indicator (fun _ : ℝ => (1:ℂ))
def freq (v : ℝ) : ℂ := ((-2*Real.pi*v:ℝ):ℂ)*I
def mult (δ v : ℝ) : ℂ := ∫ u in (-δ)..0, Complex.exp (freq v * u)

theorem box_meas (a δ : ℝ) : Measurable (box a δ) := measurable_const.indicator measurableSet_Ico
theorem box_int (a δ : ℝ) : Integrable (box a δ) := by
  apply (integrable_indicator_iff measurableSet_Ico).mpr
  exact continuous_const.integrableOn_Icc.mono_set Set.Ico_subset_Icc_self
theorem box_bound (a δ u : ℝ) : ‖box a δ u‖ ≤ 1 := by
  unfold box; by_cases h : u∈Set.Ico (a-δ) a <;> simp [h]
theorem box_cont_ae (a δ : ℝ) (hd : 0<δ) : ∀ᵐ u : ℝ, ContinuousAt (box a δ) u := by
  filter_upwards [volume.ae_ne (a-δ),volume.ae_ne a] with u hl hr
  apply continuousOn_const.continuousAt_indicator
  rw [frontier_Ico (show a-δ<a by linarith)]
  simp [hl,hr]

theorem freq_exp_norm (v u : ℝ) : ‖Complex.exp (freq v*u)‖=1 := by
  rw [show freq v*u = (((-2*Real.pi*v*u:ℝ):ℂ)*I) by unfold freq; push_cast; ring]
  exact Complex.norm_exp_ofReal_mul_I _

theorem box_fourier (a δ v : ℝ) (hd : 0≤δ) :
    𝓕 (box a δ) v = Complex.exp (freq v*a)*mult δ v := by
  rw [Real.fourier_real_eq_integral_exp_smul]
  have he (u : ℝ) : Complex.exp (((-2*Real.pi*u*v:ℝ):ℂ)*I) • box a δ u =
      (Set.Ico (a-δ) a).indicator (fun z : ℝ => Complex.exp (freq v*z)) u := by
    by_cases h : u∈Set.Ico (a-δ) a
    · simp only [box,Set.indicator_of_mem h,smul_eq_mul,mul_one]
      congr 1; unfold freq; push_cast; ring
    · simp [box,h]
  simp_rw [he]
  rw [integral_indicator measurableSet_Ico,integral_Ico_eq_integral_Ioc,
    ←intervalIntegral.integral_of_le (show a-δ≤a by linarith)]
  unfold mult
  rw [←intervalIntegral.integral_const_mul]
  have hf (u : ℝ) : Complex.exp (freq v*a)*Complex.exp (freq v*u) = Complex.exp (freq v*((u+a:ℝ):ℂ)) := by
    rw [←Complex.exp_add]; congr 1; push_cast; ring
  simp_rw [hf]
  have h := intervalIntegral.integral_comp_add_right (fun z : ℝ => Complex.exp (freq v*z)) a (a:=-δ) (b:=0)
  rw [show -δ+a=a-δ by ring,zero_add] at h
  exact h.symm

theorem mult_bound_short {δ : ℝ} (hd : 0≤δ) (v : ℝ) : ‖mult δ v‖ ≤ δ := by
  unfold mult
  apply (intervalIntegral.norm_integral_le_of_norm_le_const (C:=1) (fun u _ => (freq_exp_norm v u).le)).trans
  simp [abs_of_nonneg hd]

theorem mult_bound_tail (δ v : ℝ) (hv : v≠0) : ‖mult δ v‖ ≤ 1/(Real.pi*|v|) := by
  have hp := Real.pi_pos
  have hfreq : freq v≠0 := by unfold freq; exact mul_ne_zero (Complex.ofReal_ne_zero.mpr (by positivity)) Complex.I_ne_zero
  unfold mult
  rw [integral_exp_mul_complex hfreq,norm_div]
  have hb := norm_sub_le (Complex.exp (freq v*(0:ℝ))) (Complex.exp (freq v*(-δ:ℝ)))
  simp only [Complex.ofReal_zero,mul_zero,Complex.exp_zero,norm_one,freq_exp_norm] at hb
  have hnorm : ‖freq v‖ = 2*Real.pi*|v| := by
    unfold freq
    rw [norm_mul,Complex.norm_I,mul_one,Complex.norm_real,Real.norm_eq_abs]
    simp [abs_mul,abs_of_pos hp]
  rw [hnorm]
  simp only [Complex.ofReal_zero,mul_zero,Complex.exp_zero] at *
  exact (div_le_div_of_nonneg_right hb (by positivity)).trans_eq (by ring)
end
end GBMellinWindow

open Finset MeasureTheory Filter Complex
open scoped FourierTransform Interval Topology Classical
namespace GBMellinWindow
noncomputable section

def window (s : Finset ℕ) (c : ℕ → ℂ) (a : ℕ → ℝ) (δ u : ℝ) :=
  ∑ j ∈ s, c j*box (a j) δ u
def spectral (s : Finset ℕ) (c : ℕ → ℂ) (a : ℕ → ℝ) (v : ℝ) :=
  ∑ j ∈ s, c j*Complex.exp (freq v*(a j))
def coeffMass (s : Finset ℕ) (c : ℕ → ℂ) := ∑ j ∈ s, ‖c j‖

theorem window_meas (s : Finset ℕ) (c : ℕ → ℂ) (a : ℕ → ℝ) (δ : ℝ) :
    Measurable (window s c a δ) := Finset.measurable_sum _ fun j _ => measurable_const.mul (box_meas ..)
theorem window_int (s : Finset ℕ) (c : ℕ → ℂ) (a : ℕ → ℝ) (δ : ℝ) :
    Integrable (window s c a δ) := integrable_finsetSum _ fun j _ => (box_int ..).const_mul (c j)
theorem window_bound (s : Finset ℕ) (c : ℕ → ℂ) (a : ℕ → ℝ) (δ u : ℝ) :
    ‖window s c a δ u‖ ≤ coeffMass s c := by
  apply (norm_sum_le ..).trans
  exact sum_le_sum fun j _ => (norm_mul ..).le.trans (mul_le_of_le_one_right (norm_nonneg _) (box_bound ..))
theorem window_cont_ae (s : Finset ℕ) (c : ℕ → ℂ) (a : ℕ → ℝ) {δ : ℝ} (hd : 0<δ) :
    ∀ᵐ u : ℝ, ContinuousAt (window s c a δ) u := by
  have h := (Filter.eventually_all_finset s).mpr (fun j _ => box_cont_ae (a j) δ hd)
  filter_upwards [h] with u hu
  exact tendsto_finsetSum _ fun j hj => tendsto_const_nhds.mul (hu j hj).tendsto
theorem spectral_bound (s : Finset ℕ) (c : ℕ → ℂ) (a : ℕ → ℝ) (v : ℝ) :
    ‖spectral s c a v‖ ≤ coeffMass s c := by
  apply (norm_sum_le ..).trans
  apply le_of_eq; apply sum_congr rfl; intro i _
  rw [norm_mul,freq_exp_norm,mul_one]

theorem window_fourier (s : Finset ℕ) (c : ℕ → ℂ) (a : ℕ → ℝ) {δ : ℝ} (hd : 0≤δ) (v : ℝ) :
    𝓕 (window s c a δ) v = spectral s c a v*mult δ v := by
  let phase := fun u : ℝ => Complex.exp (((-2*Real.pi*u*v:ℝ):ℂ)*I)
  have hp (u : ℝ) : ‖phase u‖=1 := Complex.norm_exp_ofReal_mul_I _
  have hpm : Continuous phase := by dsimp [phase]; fun_prop
  have hi (j : ℕ) : Integrable (fun u => phase u*box (a j) δ u) :=
    (box_int ..).bdd_mul hpm.aestronglyMeasurable (Eventually.of_forall fun u => (hp u).le)
  rw [Real.fourier_real_eq_integral_exp_smul]
  change (∫ u, phase u*∑ j ∈ s, c j*box (a j) δ u) = _
  simp_rw [Finset.mul_sum]
  have e (j : ℕ) (u : ℝ) : phase u*(c j*box (a j) δ u) = c j*(phase u*box (a j) δ u) := by ring
  simp_rw [e]
  rw [integral_finsetSum s (fun j _ => (hi j).const_mul _)]
  simp_rw [integral_const_mul]
  unfold spectral
  rw [Finset.sum_mul]
  apply sum_congr rfl; intro j _
  have he := box_fourier (a j) δ v hd
  rw [Real.fourier_real_eq_integral_exp_smul] at he
  change (∫ u, phase u*box (a j) δ u) = _ at he
  rw [he,mul_assoc]

theorem spectral_integrable (s : Finset ℕ) (c : ℕ → ℂ) (a : ℕ → ℝ) {δ : ℝ} (hd : 0≤δ) :
    Integrable fun v => ‖𝓕 (window s c a δ) v‖^2 := by
  let F := 𝓕 (window s c a δ)
  let M := coeffMass s c
  have hM : 0≤M := sum_nonneg fun _ _ => norm_nonneg _
  have hF : Continuous F := VectorFourier.fourierIntegral_continuous Real.continuous_fourierChar
    (innerSL ℝ).continuous₂ (window_int ..)
  have hb (v : ℝ) : ‖F v‖ ≤ M*δ := by
    dsimp [F]; rw [window_fourier _ _ _ hd,norm_mul]
    exact mul_le_mul (spectral_bound ..) (mult_bound_short hd v) (norm_nonneg _) hM
  have ht (v : ℝ) : ‖F v‖*|v| ≤ M := by
    by_cases hv : v=0
    · simpa [hv] using hM
    have hvp := abs_pos.mpr hv
    have hpi : 1≤Real.pi := by linarith [Real.pi_gt_three]
    have hm := mult_bound_tail δ v hv
    have hmul : ‖mult δ v‖*|v|≤1 :=
      (le_div_iff₀ hvp).mp (hm.trans (one_div_le_one_div_of_le hvp (le_mul_of_one_le_left hvp.le hpi)))
    dsimp [F]; rw [window_fourier _ _ _ hd,norm_mul,mul_assoc]
    exact (mul_le_of_le_one_right (norm_nonneg _) hmul).trans (spectral_bound ..)
  apply (integrable_inv_one_add_sq.const_mul (M^2*(δ^2+1))).mono' (hF.norm.pow 2).aestronglyMeasurable
  apply Eventually.of_forall
  intro v
  rw [Real.norm_eq_abs,abs_of_nonneg (sq_nonneg _),←div_eq_mul_inv]
  apply (le_div_iff₀ (show 0<1+v^2 by positivity)).mpr
  have h₁ := pow_le_pow_left₀ (norm_nonneg _) (hb v) 2
  have h₂ := pow_le_pow_left₀ (mul_nonneg (norm_nonneg _) (abs_nonneg _)) (ht v) 2
  rw [mul_pow,sq_abs] at h₂
  change ‖F v‖^2*(1+v^2) ≤ _
  nlinarith only [h₁,h₂]

theorem window_energy (s : Finset ℕ) (c : ℕ → ℂ) (a : ℕ → ℝ) {δ : ℝ} (hd : 0<δ) :
    (∫ u, ‖window s c a δ u‖^2) = ∫ v, ‖spectral s c a v‖^2*‖mult δ v‖^2 := by
  rw [plancherel (window_meas ..) (window_int ..) (window_bound s c a δ) (window_cont_ae _ _ _ hd)
    (spectral_integrable _ _ _ hd.le)]
  apply integral_congr_ae
  filter_upwards with v
  rw [window_fourier _ _ _ hd.le,norm_mul,mul_pow]
end
end GBMellinWindow

open Finset MeasureTheory Filter Complex
open scoped Interval Topology Classical
namespace GBMellinWindow
open GBMean
noncomputable section

def shortSum {q : ℕ} (χ : DirichletCharacter ℂ q) (N b : ℕ) (δ u : ℝ) :=
  ∑ n ∈ (Ioc N b).filter (fun n : ℕ => Real.exp u < n ∧ (n:ℝ) ≤ Real.exp (u+δ)), centered χ n

def kernel (δ t : ℝ) := ‖mult δ (t/(-2*Real.pi))‖^2

theorem window_short {q : ℕ} (χ : DirichletCharacter ℂ q) (N b : ℕ) (δ u : ℝ) :
    window (Ioc N b) (centered χ) (fun n : ℕ => Real.log n) δ u = shortSum χ N b δ u := by
  unfold window shortSum
  rw [Finset.sum_filter]
  apply sum_congr rfl
  intro n hn
  have hnr : 0<(n:ℝ) := by exact_mod_cast (Nat.zero_le N).trans_lt (mem_Ioc.mp hn).1
  have he : u∈Set.Ico (Real.log n-δ) (Real.log n) ↔ Real.exp u < n ∧ (n:ℝ)≤Real.exp (u+δ) := by
    rw [Set.mem_Ico,←Real.lt_log_iff_exp_lt hnr,←Real.log_le_iff_le_exp hnr]
    constructor <;> rintro ⟨h₁,h₂⟩ <;> constructor <;> linarith
  by_cases h : u∈Set.Ico (Real.log n-δ) (Real.log n)
  · simp [box,h,he.mp h]
  · simp [box,h,mt he.mpr h]

theorem spectral_short {q : ℕ} (χ : DirichletCharacter ℂ q) (N b : ℕ) (v : ℝ) :
    spectral (Ioc N b) (centered χ) (fun n : ℕ => Real.log n) v = rawPoly χ N b ((-2*Real.pi)*v) := by
  apply sum_congr rfl
  intro n _
  rw [mul_comm (centered χ n)]
  unfold osc wave freq
  congr 2
  push_cast; ring

theorem kernel_short {δ : ℝ} (hd : 0≤δ) (t : ℝ) : kernel δ t ≤ δ^2 :=
  pow_le_pow_left₀ (norm_nonneg _) (mult_bound_short hd _) 2

theorem kernel_high (δ t : ℝ) (ht : t≠0) : kernel δ t ≤ 4/t^2 := by
  have hp := Real.pi_pos
  have hm := mult_bound_tail δ (t/(-2*Real.pi)) (div_ne_zero ht (by positivity))
  have he : 1/(Real.pi*|t/(-2*Real.pi)|) = 2/|t| := by
    rw [abs_div,abs_mul,abs_of_pos hp]
    norm_num
    field_simp
  rw [he] at hm
  exact (pow_le_pow_left₀ (norm_nonneg _) hm 2).trans_eq (by rw [div_pow,sq_abs]; norm_num)

theorem short_plancherel {q : ℕ} (χ : DirichletCharacter ℂ q) (N b : ℕ) {δ : ℝ} (hd : 0<δ) :
    (2*Real.pi)*(∫ u, ‖shortSum χ N b δ u‖^2) = ∫ t, ‖rawPoly χ N b t‖^2 * kernel δ t := by
  have h := window_energy (Ioc N b) (centered χ) (fun n : ℕ => Real.log n) hd
  simp_rw [window_short,spectral_short] at h
  let F := fun t => ‖rawPoly χ N b t‖^2*kernel δ t
  let d := -2*Real.pi
  have hd0 : d≠0 := by dsimp [d]; positivity
  have e (v : ℝ) : ‖rawPoly χ N b (d*v)‖^2 * ‖mult δ v‖^2 = F (d*v) := by
    dsimp [F,kernel]; rw [mul_div_cancel_left₀ _ hd0]
  change (∫ u, ‖shortSum χ N b δ u‖^2) = ∫ v, ‖rawPoly χ N b (d*v)‖^2*‖mult δ v‖^2 at h
  simp_rw [e] at h
  rw [Measure.integral_comp_mul_left,smul_eq_mul] at h
  rw [h]
  change (2*Real.pi)*(|d⁻¹| * (∫ t, F t))=∫ t, F t
  rw [abs_inv,show |d|=2*Real.pi by dsimp [d]; rw [abs_mul,abs_of_pos Real.pi_pos]; norm_num,
      ←mul_assoc,mul_inv_cancel₀ (by positivity),one_mul]

end
end GBMellinWindow

open Finset MeasureTheory Filter Complex
open scoped Interval Topology Classical
namespace GBMean
noncomputable section

def Lw (n : ℕ) : ℂ := (ArithmeticFunction.vonMangoldt n:ℝ)
def rawEnergy (q : ℕ) [NeZero q] (N b : ℕ) (t : ℝ) := ∑ χ : DirichletCharacter ℂ q, ‖rawPoly χ N b t‖^2
def energyScale (N : ℕ) : ℝ := constant*((N:ℝ)*(1+Real.log (2*N:ℝ))^2)

theorem raw_eq {q : ℕ} (χ : DirichletCharacter ℂ q) (N b : ℕ) (t : ℝ) :
    rawPoly χ N b t = twisted (Ioc N b) Lw χ t -
      if χ=1 then logPoly (Ioc N b) (fun _ => 1) t else 0 := by
  unfold rawPoly twisted logPoly poly
  by_cases h : χ=1
  · rw [if_pos h,←sum_sub_distrib]
    apply sum_congr rfl; intro n hn
    have hpos := (Nat.zero_le N).trans_lt (mem_Ioc.mp hn).1
    simp only [centered,if_neg hpos.ne',ite_eq_left h,osc,Lw,one_mul]; ring
  · rw [if_neg h,sub_zero]
    apply sum_congr rfl; intro n hn
    have hpos := (Nat.zero_le N).trans_lt (mem_Ioc.mp hn).1
    simp only [centered,if_neg hpos.ne',if_neg h,sub_zero,osc,Lw]; ring

theorem raw_energy_comparison (q : ℕ) [NeZero q] (N b : ℕ) (t : ℝ) :
    rawEnergy q N b t ≤ 2*energy (q:=q) (Ioc N b) Lw t +
      2*‖logPoly (Ioc N b) (fun _ => 1) t‖^2 := by
  let s := Ioc N b
  let flat := logPoly s (fun _ => 1) t
  have h₁ (χ : DirichletCharacter ℂ q) :
      ‖rawPoly χ N b t‖^2 ≤ 2*‖twisted s Lw χ t‖^2+(if χ=1 then 2*‖flat‖^2 else 0) := by
    rw [raw_eq]; by_cases he : χ=1
    · rw [if_pos he,if_pos he]
      have hd : ‖twisted s Lw χ t-flat‖ ≤ ‖twisted s Lw χ t‖+‖flat‖ := norm_sub_le .. 
      nlinarith only [pow_le_pow_left₀ (norm_nonneg _) hd 2,sq_nonneg (‖twisted s Lw χ t‖-‖flat‖)]
    · rw [if_neg he,if_neg he,sub_zero,add_zero]; nlinarith only [sq_nonneg ‖twisted s Lw χ t‖]
  apply (sum_le_sum fun χ _ => h₁ χ).trans_eq
  rw [sum_add_distrib,←Finset.mul_sum]
  simp only [Finset.sum_ite_eq',mem_univ,ite_true,s,flat,energy]

theorem raw_energy_cont (q : ℕ) [NeZero q] (N b : ℕ) : Continuous (rawEnergy q N b) := by
  unfold rawEnergy rawPoly osc wave; fun_prop
theorem raw_energy_pos (q : ℕ) [NeZero q] (N b : ℕ) (t : ℝ) : 0 ≤ rawEnergy q N b t :=
  sum_nonneg fun _ _ => sq_nonneg _
theorem energyScale_pos (N : ℕ) : 0≤energyScale N := by unfold energyScale constant; positivity

theorem lambda_square_sum (N b : ℕ) (hN : 0<N) (hb : b≤2*N) :
    (∑ n ∈ Ioc N b, ‖Lw n‖^2) ≤ (N:ℝ)*(1+Real.log (2*N:ℝ))^2 := by
  have hL : 0≤Real.log (2*N:ℝ) := Real.log_nonneg (by exact_mod_cast (by omega : 1≤2*N))
  calc
    _ ≤ ∑ _n ∈ Ioc N b, (1+Real.log (2*N:ℝ))^2 := by
      apply sum_le_sum; intro n hn
      rw [Lw,Complex.norm_real,Real.norm_eq_abs,abs_of_nonneg ArithmeticFunction.vonMangoldt_nonneg]
      apply pow_le_pow_left₀ ArithmeticFunction.vonMangoldt_nonneg
      have hl := Real.log_le_log (show 0<(n:ℝ) by exact_mod_cast hN.trans (mem_Ioc.mp hn).1)
        (show (n:ℝ)≤2*N by exact_mod_cast (mem_Ioc.mp hn).2.trans hb)
      linarith only [ArithmeticFunction.vonMangoldt_le_log (n:=n),hl]
    _ ≤ _ := by
      rw [sum_const,nsmul_eq_mul,Nat.card_Ioc]
      exact mul_le_mul_of_nonneg_right (by exact_mod_cast (by omega : b-N≤N)) (sq_nonneg _)

theorem raw_mean (q N b : ℕ) [NeZero q] (hN : 0<N) (hb : b≤2*N) {T : ℝ} (hT : 0<T) :
    (∫ t in (0:ℝ)..T, both (rawEnergy q N b) t) ≤
      (4*(q:ℝ)*T+16*(N:ℝ))*energyScale N := by
  let s := Ioc N b
  let L := energy (q:=q) s Lw
  let P := logPoly s (fun _ => 1)
  let S := energyScale N
  have hc : 0≤constant := by unfold constant; positivity
  have hS := energyScale_pos N
  have hL : Continuous L := energy_cont .. 
  have hP : Continuous (fun t => ‖P t‖^2) := (continuous_logPoly s _).norm.pow 2
  have hs (n : ℕ) (hn : n∈s) : 0<n ∧ n≤2*N := ⟨hN.trans (mem_Ioc.mp hn).1,(mem_Ioc.mp hn).2.trans hb⟩
  have hLbd : (∫ t in (-T)..T, L t) ≤ ((q:ℝ)*T+4*(N:ℝ))*S := by
    rw [←integrated_both _ hL]
    apply (character_energy_bound q s Lw (2*N) hT hs).trans
    push_cast; apply mul_le_mul
    · have he : (q.totient:ℝ)≤q := by exact_mod_cast q.totient_le
      nlinarith only [mul_le_mul_of_nonneg_right he hT.le]
    · exact mul_le_mul_of_nonneg_left (lambda_square_sum N b hN hb) hc
    · positivity
    · positivity
  have hq : 1≤q := Nat.pos_of_ne_zero (NeZero.ne _)
  have hQr : (1:ℝ)≤q := by exact_mod_cast hq
  have hcard : (s.card:ℝ)≤N := by dsimp [s]; rw [Nat.card_Ioc]; exact_mod_cast (by omega : b-N≤N)
  have hlog : 0≤Real.log (2*N:ℝ) := Real.log_nonneg (by exact_mod_cast (by omega : 1≤2*N))
  have hnorm : constant*(s.card:ℝ) ≤ S := by
    apply mul_le_mul_of_nonneg_left _ hc
    refine hcard.trans ?_
    apply le_mul_of_one_le_right (Nat.cast_nonneg _)
    exact one_le_pow₀ (by linarith) 
  have hflat := progression_mean 0 1 (2*N) s (fun _ => 1) T (T+4*N) hT.le (by positivity)
    (by linarith only [Nat.cast_nonneg N (α:=ℝ)]) (by push_cast; linarith only [hT]) (by simpa using hs)
  have hPbd : (∫ t in (-T)..T, ‖P t‖^2) ≤ ((q:ℝ)*T+4*(N:ℝ))*S := by
    simp only [Nat.mul_one,Nat.zero_add,norm_one,one_pow,sum_const,one_nsmul,nsmul_eq_mul,mul_one] at hflat
    change (∫ t in (-T)..T, ‖P t‖^2) ≤ _ at hflat
    apply hflat.trans
    calc
      _ = (T+4*(N:ℝ))*(constant*(s.card:ℝ)) := by ring
      _ ≤ _ := mul_le_mul (by linarith only [le_mul_of_one_le_left hT.le hQr]) hnorm (by positivity) (by positivity)
  rw [integrated_both _ (raw_energy_cont ..)]
  calc
    _ ≤ ∫ t in (-T)..T, (2*L t+2*‖P t‖^2) := by
      apply intervalIntegral.integral_mono_on (by linarith only [hT]) ((raw_energy_cont ..).intervalIntegrable ..)
        (((hL.const_mul 2).add (hP.const_mul 2)).intervalIntegrable ..)
      exact fun t _ => raw_energy_comparison q N b t
    _ = 2*(∫ t in (-T)..T, L t) + 2*(∫ t in (-T)..T, ‖P t‖^2) := by
      rw [intervalIntegral.integral_add ((hL.const_mul 2).intervalIntegrable ..) ((hP.const_mul 2).intervalIntegrable ..)]
      simp_rw [intervalIntegral.integral_const_mul]
    _ ≤ _ := by change _ ≤ _ * S; linarith only [hLbd,hPbd]

theorem raw_tail (q N b : ℕ) [NeZero q] (hN : 0<N) (hb : b≤2*N) {R : ℝ} (hr : 0<R) :
    IntegrableOn (fun t => both (rawEnergy q N b) t/t^2) (Set.Ioi R) ∧
    (∫ t in Set.Ioi R, both (rawEnergy q N b) t/t^2) ≤
      (16*(q:ℝ)/R+32*(N:ℝ)/R^2)*energyScale N := by
  let S := energyScale N
  have hS : 0≤S := energyScale_pos N
  have hct := raw_energy_cont q N b
  have H (T : ℝ) (hT : 0<T) : (∫ t in (0:ℝ)..T, both (rawEnergy q N b) t) ≤
      (4*(q:ℝ)*S)*T+16*(N:ℝ)*S := (raw_mean q N b hN hb hT).trans_eq (by dsimp [S]; ring)
  obtain ⟨hi,hbd⟩ := tail_infinite (hct.add (hct.comp continuous_neg))
    (fun t => add_nonneg (raw_energy_pos q N b t) (raw_energy_pos q N b (-t)))
    (show 0≤4*(q:ℝ)*S by positivity) (show 0≤16*(N:ℝ)*S by positivity) H hr
  exact ⟨hi,hbd.trans_eq (by unfold potential; dsimp [S]; ring)⟩
end
end GBMean

open Finset MeasureTheory Filter Complex
open scoped Interval Topology FourierTransform Classical
namespace GBMellinWindow
open GBMean
noncomputable section

def weightedEnergy (q : ℕ) [NeZero q] (N b : ℕ) (δ t : ℝ) := rawEnergy q N b t * kernel δ t

theorem individual_int {q : ℕ} (χ : DirichletCharacter ℂ q) (N b : ℕ) {δ : ℝ} (hd : 0≤δ) :
    Integrable (fun t => ‖rawPoly χ N b t‖^2*kernel δ t) := by
  let d := -2*Real.pi
  have hdn : d≠0 := by dsimp [d]; positivity
  apply (integrable_comp_mul_left_iff _ hdn).mp
  apply (spectral_integrable (Ioc N b) (centered χ) (fun n : ℕ => Real.log n) hd).congr
  filter_upwards with v
  rw [window_fourier _ _ _ hd,norm_mul,mul_pow,spectral_short]
  dsimp only [kernel]
  change _ = ‖rawPoly χ N b (d*v)‖^2 * ‖mult δ (d*v/d)‖^2
  rw [mul_div_cancel_left₀ _ hdn]

theorem weighted_sum (q : ℕ) [NeZero q] (N b : ℕ) (δ t : ℝ) :
    (∑ χ : DirichletCharacter ℂ q, ‖rawPoly χ N b t‖^2*kernel δ t) = weightedEnergy q N b δ t := by
  rw [weightedEnergy,rawEnergy,Finset.sum_mul]

theorem weighted_int (q : ℕ) [NeZero q] (N b : ℕ) {δ : ℝ} (hd : 0≤δ) :
    Integrable (weightedEnergy q N b δ) := by
  have h := integrable_finsetSum (univ : Finset (DirichletCharacter ℂ q)) (fun χ _ => individual_int χ N b hd)
  simpa only [weighted_sum] using h

theorem total_energy (q : ℕ) [NeZero q] (N b : ℕ) {δ : ℝ} (hd : 0<δ) :
    (2*Real.pi)*∑ χ : DirichletCharacter ℂ q, (∫ u, ‖shortSum χ N b δ u‖^2) =
    ∫ t in Set.Ioi (0:ℝ), both (weightedEnergy q N b δ) t := by
  rw [Finset.mul_sum]
  simp_rw [short_plancherel _ _ _ hd]
  rw [←integral_finsetSum univ (fun χ _ => individual_int χ N b hd.le)]
  simp_rw [weighted_sum]
  let F := weightedEnergy q N b δ
  have hi : Integrable F := weighted_int _ _ _ hd.le
  unfold both
  rw [integral_add hi.integrableOn hi.comp_neg.integrableOn,integral_comp_neg_Ioi,neg_zero,add_comm]
  exact (intervalIntegral.integral_Iic_add_Ioi hi.integrableOn hi.integrableOn).symm

theorem weighted_bound_short (q : ℕ) [NeZero q] (N b : ℕ) {δ : ℝ} (hd : 0≤δ) (t : ℝ) :
    both (weightedEnergy q N b δ) t ≤ δ^2*both (rawEnergy q N b) t := by
  unfold both weightedEnergy
  rw [mul_add]
  have h (v : ℝ) : rawEnergy q N b v*kernel δ v ≤ δ^2*rawEnergy q N b v :=
    (mul_le_mul_of_nonneg_left (kernel_short hd v) (raw_energy_pos ..)).trans_eq (mul_comm ..)
  exact add_le_add (h t) (h (-t))

theorem weighted_bound_high (q : ℕ) [NeZero q] (N b : ℕ) (δ t : ℝ) (ht : t≠0) :
    both (weightedEnergy q N b δ) t ≤ 4*(both (rawEnergy q N b) t/t^2) := by
  have h (v : ℝ) (hv : v≠0) : weightedEnergy q N b δ v ≤ rawEnergy q N b v*(4/v^2) :=
    mul_le_mul_of_nonneg_left (kernel_high δ v hv) (raw_energy_pos ..)
  apply (add_le_add (h t ht) (h (-t) (neg_ne_zero.mpr ht))).trans_eq
  unfold both; rw [neg_sq]; ring

theorem bands (q N b : ℕ) [NeZero q] {T R δ : ℝ} (hd : 0<δ) (hT : 0<T) (hr : T≤R)
    (hN : 0<N) (hb : b≤2*N) :
    (2*Real.pi)*∑ χ : DirichletCharacter ℂ q, (∫ u, ‖shortSum χ N b δ u‖^2) ≤
      δ^2*(∫ t in (0:ℝ)..T, both (rawEnergy q N b) t) +
      δ^2*(∫ t in T..R, both (rawEnergy q N b) t) +
      4*((16*(q:ℝ)/R+32*(N:ℝ)/R^2)*energyScale N) := by
  let G := both (weightedEnergy q N b δ)
  let E := both (rawEnergy q N b)
  have hi := weighted_int q N b hd.le
  have hG : Integrable G := hi.add hi.comp_neg
  have hC := raw_energy_cont q N b
  have hE : Continuous E := hC.add (hC.comp continuous_neg)
  have hi₁ (a b' : ℝ) (hab : a≤b') : (∫ t in a..b', G t) ≤ δ^2*(∫ t in a..b', E t) := by
    rw [←intervalIntegral.integral_const_mul]
    exact intervalIntegral.integral_mono_on hab hG.intervalIntegrable ((hE.const_mul _).intervalIntegrable ..)
      (fun t _ => weighted_bound_short q N b hd.le t)
  obtain ⟨hit,hbt⟩ := raw_tail q N b hN hb (hT.trans_le hr)
  have htail : (∫ t in Set.Ioi R, G t) ≤ 4*((16*(q:ℝ)/R+32*(N:ℝ)/R^2)*energyScale N) := by
    calc
      _ ≤ ∫ t in Set.Ioi R, 4*(E t/t^2) := setIntegral_mono_on hG.integrableOn (hit.const_mul 4) measurableSet_Ioi
        (fun t ht => weighted_bound_high q N b δ t ((hT.trans_le hr).trans ht).ne')
      _ ≤ _ := by rw [integral_const_mul]; exact mul_le_mul_of_nonneg_left hbt (by norm_num)
  rw [total_energy _ _ _ hd]
  change (∫ t in Set.Ioi (0:ℝ), G t) ≤ _
  rw [←intervalIntegral.integral_interval_add_Ioi (b:=R) hG.integrableOn hG.integrableOn,
    ←intervalIntegral.integral_add_adjacent_intervals (b:=T) hG.intervalIntegrable hG.intervalIntegrable]
  exact add_le_add (add_le_add (hi₁ 0 T hT.le) (hi₁ T R hr)) htail

end
end GBMellinWindow

open Finset MeasureTheory Filter Complex
open scoped Interval Topology Classical
namespace GBMellinWindow
open GBMean
noncomputable section

theorem middle_reduction (a B c : ℕ) :
    ∃ C : ℝ, 0<C ∧ ∀ᶠ N : ℕ in atTop, ∀ q : ℕ, (hq : 0<q) → (q:ℝ)≤(Real.log N)^B →
      ∀ b : ℕ, N≤b → b≤2*N → ∀ δ R : ℝ, 0<δ → (Real.log N)^c ≤ R →
      letI : NeZero q := ⟨hq.ne'⟩
      (2*Real.pi)*∑ χ : DirichletCharacter ℂ q, (∫ u, ‖shortSum χ N b δ u‖^2) ≤
        C*(δ^2*(N:ℝ)^2/(Real.log N)^a +
          ((q:ℝ)/R+(N:ℝ)/R^2)*(N:ℝ)*(1+Real.log (2*N:ℝ))^2) +
        δ^2*(∫ t in (Real.log N)^c..R, both (rawEnergy q N b) t) := by
  obtain ⟨M,hM,hlow⟩ := low_raw_energy a B c
  refine ⟨M+128*constant,show 0<M+128*constant by unfold constant; positivity,?_⟩
  have hlog := (Real.tendsto_log_atTop.comp (tendsto_natCast_atTop_atTop (R:=ℝ))).eventually (eventually_ge_atTop 1)
  filter_upwards [hlow,hlog,eventually_ge_atTop (1:ℕ)] with N hN hL hN1
  intro q hq hqL b hNb hb δ R hd hR
  let : NeZero q := ⟨hq.ne'⟩
  let T := (Real.log N)^c
  have hLp : 0<Real.log N := zero_lt_one.trans_le hL
  have hT : 0<T := pow_pos hLp _
  have hRp := hT.trans_le hR
  have hlow' := hN q hq hqL b hNb hb
  have hct (χ : DirichletCharacter ℂ q) : Continuous (fun t => ‖rawPoly χ N b t‖^2) := by unfold rawPoly osc wave; fun_prop
  have hle : (∫ t in (0:ℝ)..T, both (rawEnergy q N b) t) ≤ M*(N:ℝ)^2/(Real.log N)^a := by
    rw [integrated_both _ (raw_energy_cont ..)]
    unfold rawEnergy
    rw [intervalIntegral.integral_finsetSum fun χ _ => (hct χ).intervalIntegrable ..]
    exact hlow'
  have hbnd := bands q N b hd hT hR hN1 hb
  apply hbnd.trans
  let x := δ^2*(N:ℝ)^2/(Real.log N)^a
  let z := (N:ℝ)*(1+Real.log (2*N:ℝ))^2
  let A := (q:ℝ)/R
  let D := (N:ℝ)/R^2
  have hx : 0≤x := by dsimp [x]; positivity
  have hz : 0≤z := by dsimp [z]; positivity
  have hA : 0≤A := by dsimp [A]; positivity
  have hD : 0≤D := by dsimp [D]; positivity
  have hc : 0≤constant := by unfold constant; positivity
  have h₁ := mul_le_mul_of_nonneg_left hle (sq_nonneg δ)
  have htop : δ^2*(M*(N:ℝ)^2/(Real.log N)^a) = M*x := by dsimp [x]; ring
  rw [htop] at h₁
  have htail : 4*((16*(q:ℝ)/R+32*(N:ℝ)/R^2)*energyScale N) ≤ 128*constant*((A+D)*z) := by
    have he : 4*((16*(q:ℝ)/R+32*(N:ℝ)/R^2)*energyScale N) = (64*A+128*D)*constant*z := by dsimp [A,D,energyScale,z]; ring
    rw [he]
    nlinarith only [mul_nonneg (mul_nonneg hc hA) hz]
  have heq : ((q:ℝ)/R+(N:ℝ)/R^2)*(N:ℝ)*(1+Real.log (2*N:ℝ))^2=(A+D)*z := by dsimp [A,D,z]; ring
  rw [heq]
  change _ ≤ (M+128*constant)*(x+(A+D)*z)+δ^2*(∫ t in T..R, both (rawEnergy q N b) t)
  nlinarith only [h₁,htail,mul_nonneg hM.le (mul_nonneg (add_nonneg hA hD) hz),mul_nonneg hc hx]
end
end GBMellinWindow

set_option maxHeartbeats 4000000 in
theorem Conjectures.Goldbach.ShortProgressionsMiddleBand :
∀ a B c : ℕ, ∃ C : ℝ, 0<C ∧ ∀ᶠ N : ℕ in Filter.atTop,
  ∀ q : ℕ, (hq : 0<q) → (q:ℝ)≤(Real.log N)^B → ∀ b : ℕ, N≤b → b≤2*N →
  ∀ δ R : ℝ, 0<δ → (Real.log N)^c≤R →
  letI : NeZero q := ⟨hq.ne'⟩
  let I := Finset.Ioc N b
  let d := fun (χ : DirichletCharacter ℂ q) (n : ℕ) => if n=0 then 0 else
    χ (n:ZMod q)*(ArithmeticFunction.vonMangoldt n:ℂ)-(@ite ℂ (χ=1) (Classical.propDecidable _) 1 0)
  let W := fun (χ : DirichletCharacter ℂ q) (u : ℝ) =>
    ∑ n ∈ I.filter (fun n : ℕ => Real.exp u < n ∧ (n:ℝ) ≤ Real.exp (u+δ)), d χ n
  let E := fun t : ℝ => ∑ χ : DirichletCharacter ℂ q,
    ‖∑ n ∈ I, Complex.exp (((Real.log n*t:ℝ):ℂ)*Complex.I)*d χ n‖^2
  (2*Real.pi)*∑ χ : DirichletCharacter ℂ q, (∫ u, ‖W χ u‖^2) ≤
    C*(δ^2*(N:ℝ)^2/(Real.log N)^a+((q:ℝ)/R+(N:ℝ)/R^2)*(N:ℝ)*(1+Real.log (2*N:ℝ))^2) +
    δ^2*intervalIntegral (fun t => E t+E (-t)) ((Real.log N)^c) R MeasureTheory.volume := by
  intro a B c
  simpa only [GBMellinWindow.shortSum, GBMean.both, GBMean.rawEnergy, GBMean.rawPoly, GBMean.centered, GBMean.osc, GBMean.wave] using GBMellinWindow.middle_reduction a B c
